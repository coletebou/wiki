---
// Study I: the tmux keymap. A drawn ANSI keyboard; pick a layer (Alt, Ctrl+b prefix, Ctrl, mouse), then point at, tap,
// tab to, or actually press a key to read what it does and the line of tmux.conf that makes it so.
import { BINDINGS, LAYERS, MOUSE, type Binding } from '../data/tmux-keymap';

const U = 44;
const GAP = 5;
type K = [id: string, legend: string, width?: number];
const rows: K[][] = [
  [['backquote', '`'], ...'1234567890'.split('').map((d): K => [d, d]), ['minus', '-'], ['equal', '='], ['backspace', '⌫', 2]],
  [['tab', 'Tab', 1.5], ...'qwertyuiop'.split('').map((c): K => [c, c.toUpperCase()]), ['lbracket', '['], ['rbracket', ']'], ['backslash', '\\', 1.5]],
  [['caps', 'Caps', 1.75], ...'asdfghjkl'.split('').map((c): K => [c, c.toUpperCase()]), ['semicolon', ';'], ['quote', "'"], ['enter', 'Return', 2.25]],
  [['lshift', 'Shift', 2.25], ...'zxcvbnm'.split('').map((c): K => [c, c.toUpperCase()]), ['comma', ','], ['period', '.'], ['slash', '/'], ['rshift', 'Shift', 2.75]],
  [['lctrl', 'Ctrl', 1.25], ['lalt', 'Alt ⌥', 1.25], ['lmeta', '⌘', 1.25], ['space', '', 6.25], ['rmeta', '⌘', 1.25], ['ralt', 'Alt ⌥', 1.25], ['fn', 'Fn', 1.25], ['rctrl', 'Ctrl', 1.25]],
];
const keys = rows.flatMap((row, r) => {
  let x = 0;
  return row.map(([id, legend, w = 1]) => {
    const k = { id, legend, x, y: r * (U + GAP), w: w * U + (w - 1) * GAP };
    x += w * U + w * GAP;
    return k;
  });
});
const width = Math.max(...keys.map((k) => k.x + k.w));
const height = 5 * U + 4 * GAP;

const SHORT: Record<string, string> = {
  'Previous window': '‹ window', 'Next window': 'window ›', 'Next session': 'session ›', 'Previous session': '‹ session',
  'New agent window': 'agent', 'Kill window': 'kill', 'Capture scrollback': 'capture', 'Capture to the clipboard': 'clip',
  'Clear scrollback': 'clear', 'New window, same host': 'new', 'New local window': 'local', 'Split side by side': 'split |',
  'Split top and bottom': 'split —', 'New Claude window that says hi': 'claude', 'Send Ctrl+C': '^C', 'Send Ctrl+D': '^D',
  'Send Ctrl+Z': '^Z', 'Send Ctrl+L': '^L', 'Reload the config': 'reload', 'Toggle the mouse': 'mouse', 'Session tree': 'tree',
  'Window tree': 'windows', 'Toggle the status bar': 'bar', 'Toggle the sessions row': 'rows', 'Save the layout': 'save',
  'Restore the layout': 'restore', Detach: 'detach', 'Kill pane': 'kill', 'Copy mode': 'copy', 'Paste the buffer': 'paste',
};
const short = (b: Binding) => SHORT[b.action] ?? (b.action.startsWith('Window ') ? `win ${b.key}` : b.action.toLowerCase());
const on = (layer: string, id: string) => BINDINGS.filter((b) => b.layer === layer && b.key === id);
const layerIds = ['alt', 'prefix', 'root'] as const;
const data = JSON.stringify({ bindings: BINDINGS, mouse: MOUSE, layers: LAYERS }).replace(/</g, '\\u003c');
const dx = 'https://github.com/coletebou/dx/blob/master/base/tmux.conf';
---
<figure class="study tmux-keymap" data-pagefind-ignore data-layer="alt" aria-labelledby="tk-title">
  <figcaption class="study-head">
    <p class="study-title" id="tk-title"><b>Studium</b>The tmux keymap</p>
    <p class="study-hint">Choose a layer, then point at a key, tap it, or focus the drawing and press the chord.</p>
  </figcaption>
  <div class="study-tools" role="toolbar" aria-label="Layer">
    {LAYERS.map((l, i) => (
      <button type="button" class="ink-btn" data-set-layer={l.id} aria-pressed={i === 0 ? 'true' : 'false'}>{l.label}</button>
    ))}
  </div>
  <div class="study-scroll">
    <svg class="study-svg tk-board" viewBox={`-14 -40 ${width + 28} ${height + 60}`} role="group" aria-label="Keyboard. Focus it and press a chord to look it up." tabindex="0" style="min-width: 600px">
      <defs>
        <pattern id="tk-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="6" stroke="var(--sanguine-2)" stroke-width="1.3" opacity="0.55" />
        </pattern>
        <pattern id="tk-hatch-ink" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
          <line x1="0" y1="0" x2="0" y2="5" stroke="currentColor" stroke-width="0.8" opacity="0.35" />
        </pattern>
        <filter id="tk-ink" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="3" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="1.6" />
        </filter>
      </defs>
      <text class="caps tk-note" x="0" y="-18" data-for="alt">Hold Alt, press a key: nothing first</text>
      <text class="caps tk-note" x="0" y="-18" data-for="prefix">First Ctrl+b, release, then a key</text>
      <text class="caps tk-note" x="0" y="-18" data-for="root">Ctrl chords tmux keeps for itself</text>
      <text class="caps tk-note" x="0" y="-18" data-for="mouse">The mouse layer is described below</text>
      <rect x="-10" y="-8" width={width + 20} height={height + 16} rx="12" class="ink-fine" filter="url(#tk-ink)" />
      {keys.map((k) => {
        const classes = ['key', 'node'];
        for (const l of layerIds) if (on(l, k.id).length) classes.push(`b-${l}`);
        if (k.id === 'lalt' || k.id === 'ralt') classes.push('m-alt');
        if (k.id === 'lctrl' || k.id === 'rctrl') classes.push('m-ctrl');
        if (k.id === 'b') classes.push('p-b');
        if (k.id === 'lshift' || k.id === 'rshift') classes.push('m-shift');
        const bound = classes.some((c) => c.startsWith('b-'));
        return (
          <g class={classes.join(' ')} data-key={k.id} transform={`translate(${k.x} ${k.y})`} tabindex={bound ? '-1' : undefined} role={bound ? 'button' : undefined} aria-label={bound ? `Key ${k.legend || 'space'}` : undefined}>
            <rect class="box" width={k.w} height={U} rx="6" filter="url(#tk-ink)" />
            <rect class="fill" width={k.w} height={U} rx="6" />
            <text class="legend" x="7" y="16">{k.legend}</text>
            {layerIds.map((l) => {
              const bs = on(l, k.id);
              if (!bs.length) return null;
              const plain = bs.find((b) => !b.shift && !(l === 'prefix' && b.ctrl));
              const extra = bs.find((b) => b.shift || (l === 'prefix' && b.ctrl));
              return (
                <g class="lbl" data-for={l}>
                  {plain && <text class="tk-short" x={k.w / 2} y="31" text-anchor="middle">{short(plain)}</text>}
                  {extra && <text class="tk-short tk-short-2" x={k.w / 2} y={plain ? 41 : 31} text-anchor="middle">{extra.shift ? '⇧' : '^'}{short(extra)}</text>}
                </g>
              );
            })}
          </g>
        );
      })}
    </svg>
  </div>
  <div class="study-note tk-note-panel" aria-live="polite">
    <h4>Point at a key</h4>
    <p>Sanguine keys do something in this layer. On a Mac, Alt is the Option key: Cole’s Ghostty makes the left Option key act as Alt (<code>macos-option-as-alt = left</code>), and Termius has the same switch on the phone.</p>
  </div>
  <div class="tk-mouse" hidden>
    <table class="study-table">
      <thead><tr><th>Do</th><th>With</th><th>Why</th></tr></thead>
      <tbody>{MOUSE.map((m) => <tr><td>{m.action}</td><td>{m.how}</td><td>{m.why}</td></tr>)}</tbody>
    </table>
  </div>
  <details>
    <summary>Every binding, as a list</summary>
    <table class="study-table">
      <thead><tr><th>Keys</th><th>Does</th><th>Line in <a href={dx}>tmux.conf</a></th></tr></thead>
      <tbody>
        {BINDINGS.map((b) => (
          <tr>
            <td style="white-space:nowrap">{b.chord.map((c, i) => (c === '→' ? <span> then </span> : <><kbd>{c}</kbd>{b.chord[i + 1] && b.chord[i + 1] !== '→' && c !== '→' ? '+' : ''}</>))}</td>
            <td>{b.action}{b.stock ? ' (tmux default)' : ''}</td>
            <td><code>{b.conf}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
  <script type="application/json" class="tk-data" set:html={data} />
</figure>

<style>
  .tk-board .key .box {
    fill: color-mix(in srgb, var(--paper) 92%, transparent);
    stroke: currentColor;
    stroke-width: 1.15;
  }
  .tk-board .key .fill {
    fill: transparent;
    pointer-events: none;
  }
  .tk-board .legend {
    font-size: 13px;
    fill: var(--ink-2);
  }
  .tk-board .tk-short {
    font-size: 9.5px;
    font-style: italic;
    fill: var(--sanguine);
    display: none;
  }
  .tk-board .lbl {
    display: none;
  }
  .tk-board .tk-note {
    display: none;
    fill: var(--ink-3);
    font-size: 11px;
  }
  .tmux-keymap[data-layer='alt'] .tk-note[data-for='alt'],
  .tmux-keymap[data-layer='prefix'] .tk-note[data-for='prefix'],
  .tmux-keymap[data-layer='root'] .tk-note[data-for='root'],
  .tmux-keymap[data-layer='mouse'] .tk-note[data-for='mouse'] {
    display: inline;
  }
  .tmux-keymap[data-layer='alt'] .lbl[data-for='alt'],
  .tmux-keymap[data-layer='prefix'] .lbl[data-for='prefix'],
  .tmux-keymap[data-layer='root'] .lbl[data-for='root'] {
    display: inline;
  }
  .tk-board .lbl .tk-short {
    display: inline;
  }
  .tmux-keymap[data-layer='alt'] .key.b-alt .fill,
  .tmux-keymap[data-layer='prefix'] .key.b-prefix .fill,
  .tmux-keymap[data-layer='root'] .key.b-root .fill {
    fill: url(#tk-hatch);
  }
  .tmux-keymap[data-layer='alt'] .key.b-alt,
  .tmux-keymap[data-layer='prefix'] .key.b-prefix,
  .tmux-keymap[data-layer='root'] .key.b-root {
    cursor: pointer;
  }
  .tmux-keymap[data-layer='alt'] .key.b-alt .box,
  .tmux-keymap[data-layer='prefix'] .key.b-prefix .box,
  .tmux-keymap[data-layer='root'] .key.b-root .box {
    stroke: var(--sanguine);
  }
  .tmux-keymap[data-layer='alt'] .key.m-alt .box,
  .tmux-keymap[data-layer='prefix'] .key.m-ctrl .box,
  .tmux-keymap[data-layer='prefix'] .key.p-b .box,
  .tmux-keymap[data-layer='root'] .key.m-ctrl .box {
    fill: color-mix(in srgb, var(--ink) 80%, transparent);
  }
  .tmux-keymap[data-layer='alt'] .key.m-alt .legend,
  .tmux-keymap[data-layer='prefix'] .key.m-ctrl .legend,
  .tmux-keymap[data-layer='prefix'] .key.p-b .legend,
  .tmux-keymap[data-layer='root'] .key.m-ctrl .legend {
    fill: var(--paper);
  }
  .tmux-keymap[data-layer='prefix'] .key.p-b .lbl {
    display: none;
  }
  .tmux-keymap .key.m-shift.lit .box {
    fill: url(#tk-hatch-ink);
  }
  .tmux-keymap .key.on .box {
    stroke-width: 2.6;
    fill: color-mix(in srgb, var(--sanguine) 22%, var(--paper));
  }
  .tmux-keymap .key:focus-visible .box {
    stroke-dasharray: 4 3;
    stroke-width: 2.2;
  }
  .tmux-keymap[data-layer='mouse'] .tk-board {
    opacity: 0.35;
  }
  .tk-note-panel :global(kbd) {
    font-size: 0.75em;
  }
  .tk-note-panel :global(.alt-line + .alt-line) {
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--rule);
  }
</style>

<script>
  type Binding = { layer: string; key: string; shift?: boolean; ctrl?: boolean; chord: string[]; action: string; why: string; conf: string; stock?: boolean };
  type Data = { bindings: Binding[]; mouse: { action: string; how: string; why: string }[]; layers: { id: string; label: string; note: string }[] };

  const CODE_TO_KEY: Record<string, string> = { Minus: 'minus', Equal: 'equal', Backslash: 'backslash', BracketLeft: 'lbracket', BracketRight: 'rbracket', Semicolon: 'semicolon', Quote: 'quote', Comma: 'comma', Period: 'period', Slash: 'slash', Backquote: 'backquote', Space: 'space' };
  const keyOf = (code: string) => CODE_TO_KEY[code] ?? code.replace(/^(Key|Digit)/, '').toLowerCase();

  for (const fig of document.querySelectorAll<HTMLElement>('.tmux-keymap')) {
    const data: Data = JSON.parse(fig.querySelector('.tk-data')!.textContent!);
    const panel = fig.querySelector<HTMLElement>('.tk-note-panel')!;
    const board = fig.querySelector<SVGSVGElement>('.tk-board')!;
    const mouse = fig.querySelector<HTMLElement>('.tk-mouse')!;
    let prefixArmed = 0;

    const chordHtml = (chord: string[]) => {
      const out: string[] = [];
      chord.forEach((c, i) => {
        if (c === '→') out.push(' then ');
        else out.push(`<kbd>${c.replace(/[<&]/g, (m) => (m === '<' ? '&lt;' : '&amp;'))}</kbd>${chord[i + 1] && chord[i + 1] !== '→' ? '+' : ''}`);
      });
      return out.join('');
    };
    const esc = (s: string) => s.replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[m]!);

    function layer(): string {
      return fig.dataset.layer!;
    }

    function setLayer(id: string) {
      fig.dataset.layer = id;
      for (const b of fig.querySelectorAll<HTMLButtonElement>('[data-set-layer]')) b.setAttribute('aria-pressed', String(b.dataset.setLayer === id));
      mouse.hidden = id !== 'mouse';
      const l = data.layers.find((x) => x.id === id)!;
      panel.innerHTML = `<h4>${esc(l.label)}</h4><p>${esc(l.note)}</p>`;
      for (const k of board.querySelectorAll<SVGGElement>('.key')) {
        const bound = k.classList.contains(`b-${id}`);
        k.setAttribute('tabindex', bound ? '0' : '-1');
        k.classList.remove('on');
      }
    }

    function show(key: string, opts: { shift?: boolean; ctrl?: boolean } = {}) {
      const l = layer();
      let list = data.bindings.filter((b) => b.layer === l && b.key === key);
      if (!list.length) {
        panel.innerHTML = `<h4>Nothing here</h4><p>That key has no binding in this layer.</p>`;
        return;
      }
      if (opts.shift !== undefined || opts.ctrl !== undefined) {
        const exact = list.filter((b) => Boolean(b.shift) === Boolean(opts.shift) && (l !== 'prefix' || Boolean(b.ctrl) === Boolean(opts.ctrl)));
        if (exact.length) list = exact;
      }
      for (const k of board.querySelectorAll('.key')) k.classList.toggle('on', (k as SVGGElement).dataset.key === key);
      for (const k of board.querySelectorAll('.m-shift')) k.classList.toggle('lit', list.some((b) => b.shift));
      panel.innerHTML = list
        .map(
          (b) => `<div class="alt-line"><h4>${chordHtml(b.chord)} &nbsp;${esc(b.action)}${b.stock ? ' <small>(tmux default)</small>' : ''}</h4><p>${esc(b.why)}</p>${b.stock ? '' : `<span class="where"><code>${esc(b.conf)}</code></span>`}</div>`,
        )
        .join('');
    }

    fig.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-set-layer]');
      if (btn) return setLayer(btn.dataset.setLayer!);
      const k = (e.target as Element).closest<SVGGElement>('.key');
      if (k && k.classList.contains(`b-${layer()}`)) show(k.dataset.key!);
    });
    board.addEventListener('pointerover', (e) => {
      if ((e as PointerEvent).pointerType !== 'mouse') return;
      const k = (e.target as Element).closest<SVGGElement>('.key');
      if (k && k.classList.contains(`b-${layer()}`)) show(k.dataset.key!);
    });
    board.addEventListener('focusin', (e) => {
      const k = (e.target as Element).closest<SVGGElement>('.key');
      if (k && k.classList.contains(`b-${layer()}`)) show(k.dataset.key!);
    });
    board.addEventListener('keydown', (e) => {
      const target = e.target as Element;
      if ((e.key === 'Enter' || e.key === ' ') && target.closest('.key')) {
        e.preventDefault();
        show((target.closest('.key') as SVGGElement).dataset.key!);
        return;
      }
      if (['Shift', 'Alt', 'Control', 'Meta'].includes(e.key)) return;
      const key = keyOf(e.code);
      if (e.altKey && !e.ctrlKey && !e.metaKey) {
        e.preventDefault();
        if (layer() !== 'alt') setLayer('alt');
        show(key, { shift: e.shiftKey });
        return;
      }
      if (e.ctrlKey && key === 'b') {
        e.preventDefault();
        if (layer() !== 'prefix') setLayer('prefix');
        prefixArmed = Date.now();
        panel.innerHTML = '<h4><kbd>Ctrl</kbd>+<kbd>B</kbd> pressed</h4><p>Now press the second key.</p>';
        return;
      }
      if (prefixArmed && Date.now() - prefixArmed < 4000) {
        e.preventDefault();
        prefixArmed = 0;
        show(key, { shift: e.shiftKey, ctrl: e.ctrlKey });
        return;
      }
      if (e.ctrlKey && key === 'k') {
        e.preventDefault();
        setLayer('root');
        show('k');
      }
    });

    setLayer('alt');
  }
</script>
