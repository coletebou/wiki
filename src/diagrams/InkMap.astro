---
// The engine behind the node-and-flow studies (agent fleet, observability, the Cloudflare front door): an ink drawing of
// boxes, ledgers and marks joined by curved flows, with views to switch between, a walk-through that lights up each
// step, and any part you click or tab to explained below. Everything is drawn at build time; the script only toggles.
import type { FNode, Flow, Scene } from '../data/agent-fleet';
import { emblem } from './emblems';
import { HATCH_TURN, overshoot, plate } from './ink';

interface Props {
  scenes: Scene[];
  initial?: string;
  title: string;
  hint: string;
  uid: string;
  /** Run particles along lit flows (the observability path). */
  particles?: boolean;
  extraClass?: string;
}
const { scenes, initial, title, hint, uid, particles = false, extraClass = '' } = Astro.props;
const first = scenes.find((s) => s.id === initial) ?? scenes[0];
const W = 800;
const H = 470;

type P = { x: number; y: number };
const center = (n: FNode): P => (n.kind === 'dot' ? { x: n.x, y: n.y } : { x: n.x + (n.w ?? 0) / 2, y: n.y + (n.h ?? 0) / 2 });
function edge(n: FNode, toward: P): P {
  const c = center(n);
  const dx = toward.x - c.x;
  const dy = toward.y - c.y;
  const len = Math.hypot(dx, dy) || 1;
  if (n.kind === 'dot') return { x: c.x + (dx / len) * ((n.r ?? 8) + 4), y: c.y + (dy / len) * ((n.r ?? 8) + 4) };
  const hw = (n.w ?? 0) / 2;
  const hit = (hh: number) => Math.min(dx === 0 ? Infinity : hw / Math.abs(dx), dy === 0 ? Infinity : hh / Math.abs(dy));
  let t = hit((n.h ?? 0) / 2);
  // A scroll's rolls stand proud of its sheet: a flow meeting it within a roll's width stops at the roll's end.
  if (n.kind === 'store' && Math.abs(dx * t) > hw - ROLL - 1) t = hit((n.h ?? 0) / 2 + 4.8);
  return { x: c.x + dx * t + (dx / len) * 4, y: c.y + dy * t + (dy / len) * 4 };
}
const f = (n: number) => Math.round(n * 10) / 10;
function geometry(scene: Scene, fl: Flow) {
  const a = scene.nodes.find((n) => n.id === fl.from)!;
  const b = scene.nodes.find((n) => n.id === fl.to)!;
  if (!a || !b) throw new Error(`${scene.id}: flow ${fl.id} joins unknown nodes`);
  if (a === b) {
    const c = center(a);
    const u = { x: c.x - W / 2, y: c.y - H / 2 };
    const ul = Math.hypot(u.x, u.y) || 1;
    const o = { x: u.x / ul, y: u.y / ul };
    const p = { x: -o.y, y: o.x };
    const s = { x: c.x + o.x * 11 + p.x * 7, y: c.y + o.y * 11 + p.y * 7 };
    const e = { x: c.x + o.x * 11 - p.x * 7, y: c.y + o.y * 11 - p.y * 7 };
    const c1 = { x: c.x + o.x * 58 + p.x * 34, y: c.y + o.y * 58 + p.y * 34 };
    const c2 = { x: c.x + o.x * 58 - p.x * 34, y: c.y + o.y * 58 - p.y * 34 };
    return { d: `M${f(s.x)} ${f(s.y)} C${f(c1.x)} ${f(c1.y)} ${f(c2.x)} ${f(c2.y)} ${f(e.x)} ${f(e.y)}`, lx: c.x + o.x * 64, ly: c.y + o.y * 64 + 4, len: 160 };
  }
  const p1 = center(a);
  const p2 = center(b);
  const dx = p2.x - p1.x;
  const dy = p2.y - p1.y;
  const len = Math.hypot(dx, dy) || 1;
  const bend = fl.bend ?? 0;
  const ctrl = { x: (p1.x + p2.x) / 2 + (-dy / len) * bend, y: (p1.y + p2.y) / 2 + (dx / len) * bend };
  const s = edge(a, ctrl);
  const e = edge(b, ctrl);
  const mid = { x: 0.25 * s.x + 0.5 * ctrl.x + 0.25 * e.x, y: 0.25 * s.y + 0.5 * ctrl.y + 0.25 * e.y };
  return { d: `M${f(s.x)} ${f(s.y)} Q${f(ctrl.x)} ${f(ctrl.y)} ${f(e.x)} ${f(e.y)}`, lx: mid.x, ly: mid.y - 6, len: Math.round(Math.hypot(e.x - s.x, e.y - s.y) * 1.25) };
}

// The hand: every part drawn as an engraver would. Boxes are ruled cartouches whose lines run past their corners, as
// a draughtsman's do; stores are scrolls, rolled at both ends; tabs are the tags that hung from them; frames are
// plates with cornerpieces. Shadows fall to the lower right in Leonardo's left-handed hatching.
const ROLL = 11;
function scroll(x: number, y: number, w: number, h: number) {
  const ext = 2.2;
  const ry = 2.3;
  const roll = (x0: number) => {
    const cx = x0 + ROLL / 2;
    return {
      body: `M${x0} ${y - ext}V${y + h + ext}A${ROLL / 2} ${ry} 0 0 0 ${x0 + ROLL} ${y + h + ext}V${y - ext}Z`,
      shade: `M${f(x0 + ROLL * 0.56)} ${y - ext}V${f(y + h + ext + ry * 0.9)}A${ROLL / 2} ${ry} 0 0 0 ${x0 + ROLL} ${y + h + ext}V${y - ext}Z`,
      end: `M${x0} ${y - ext}A${ROLL / 2} ${ry} 0 1 0 ${x0 + ROLL} ${y - ext}A${ROLL / 2} ${ry} 0 1 0 ${x0} ${y - ext}Z`,
      // The roll's end shows the sheet wound on itself: a spiral, not a ring.
      curl: `M${f(cx - 3.6)} ${y - ext}A3.6 1.6 0 1 0 ${f(cx + 3.4)} ${f(y - ext - 0.3)}A2.4 1 0 1 0 ${f(cx - 1.8)} ${f(y - ext + 0.1)}A1.1 0.45 0 1 0 ${f(cx + 0.6)} ${f(y - ext)}`,
      knobs: `M${cx} ${f(y - ext - ry)}v-3.2M${cx} ${f(y + h + ext + ry)}v3.2`,
    };
  };
  return [roll(x), roll(x + w - ROLL)];
}
const tagPath = (x: number, y: number, w: number, h: number) => `M${x + 8} ${y}H${x + w}V${y + h}H${x + 8}L${x} ${y + h / 2}Z`;
function cornerpieces(x: number, y: number, w: number, h: number) {
  const i = 5;
  return [
    [x + i, y + i, 1, 1],
    [x + w - i, y + i, -1, 1],
    [x + i, y + h - i, 1, -1],
    [x + w - i, y + h - i, -1, -1],
  ]
    .map(([cx, cy, sx, sy]) => `M${cx} ${cy + sy * 11}A11 11 0 0 ${sx === sy ? 0 : 1} ${cx + sx * 11} ${cy}M${cx + sx * 3.4} ${cy + sy * 3.4}m-0.9 0a0.9 0.9 0 1 0 1.8 0a0.9 0.9 0 1 0 -1.8 0`)
    .join('');
}
const sheet = plate(W, H);

const payload = JSON.stringify(
  scenes.map((s) => ({
    id: s.id,
    name: s.name,
    intro: s.intro,
    steps: s.steps,
    hooks: s.hooks ?? null,
    nodes: Object.fromEntries(s.nodes.map((n) => [n.id, { label: n.label, sub: n.sub ?? '', info: n.info ?? '' }])),
    flows: s.flows.map(({ id, from, to, label }) => ({ id, from, to, label: label ?? '' })),
  })),
).replace(/</g, '\\u003c');
---
<figure class={`study inkmap ${extraClass}`} data-pagefind-ignore data-scene={first.id} data-particles={particles ? 'on' : undefined} aria-labelledby={`${uid}-title`}>
  <figcaption class="study-head">
    <p class="study-title" id={`${uid}-title`}><b>Studium</b>{title}</p>
    <p class="study-hint">{hint}</p>
  </figcaption>
  {scenes.length > 1 && (
    <div class="study-tools" role="tablist" aria-label="Views">
      {scenes.map((s) => (
        <button type="button" class="ink-btn" role="tab" data-show={s.id} aria-selected={s.id === first.id ? 'true' : 'false'}>{s.name}</button>
      ))}
    </div>
  )}
  <div class="study-scroll">
    <svg class="study-svg inkmap-svg" viewBox={`0 0 ${W} ${H}`} role="group" aria-label={title} style="min-width: 660px">
      <defs>
        {/* Hatching from upper left to lower right, the way Leonardo's left hand ran. */}
        <pattern id={`${uid}-hatch`} width="3.6" height="3.6" patternUnits="userSpaceOnUse" patternTransform={`rotate(${HATCH_TURN})`}>
          <line x1="0" y1="0" x2="0" y2="3.6" stroke="currentColor" stroke-width="0.75" opacity="0.5" />
        </pattern>
        <pattern id={`${uid}-chalk`} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform={`rotate(${HATCH_TURN})`}>
          <line x1="0" y1="0" x2="0" y2="4" stroke="var(--sanguine-2)" stroke-width="1.1" opacity="0.6" />
        </pattern>
        <marker id={`${uid}-arrow`} viewBox="0 0 12 10" refX="10.5" refY="5" markerWidth="8" markerHeight="7" orient="auto-start-reverse">
          <path d="M0.8 1.2 L11.2 5 L0.8 8.8 L3.6 5 Z" stroke="none" style="fill: var(--ink-3); fill: context-stroke" />
        </marker>
        <marker id={`${uid}-prick`} viewBox="0 0 6 6" refX="3" refY="3" markerWidth="3.2" markerHeight="3.2">
          <circle cx="3" cy="3" r="2.2" stroke="none" style="fill: var(--ink-3); fill: context-stroke" />
        </marker>
        <filter id={`${uid}-ink`} x="-3%" y="-3%" width="106%" height="106%">
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="1.4" />
        </filter>
      </defs>
      <g class="plate" aria-hidden="true">
        <path d={sheet.ticks} />
        <path d={sheet.corners} />
      </g>
      {scenes.map((scene) => (
        <g class="scene" data-scene={scene.id} data-quiet={scene.flows.length >= 8 ? 'true' : undefined} display={scene.id === first.id ? undefined : 'none'}>
          {scene.decor && <g class="decor" aria-hidden="true" set:html={scene.decor} />}
          {scene.emblem && (
            <g class="emblem" aria-hidden="true">
              <g transform={`translate(${scene.emblem.x} ${scene.emblem.y}) scale(${scene.emblem.size / 100})`} set:html={emblem(scene.emblem, uid)} />
              {scene.emblem.label && <text class="label-hand emblem-label" x={scene.emblem.x} y={scene.emblem.y + scene.emblem.size / 2 + 16} text-anchor="middle">{scene.emblem.label}</text>}
            </g>
          )}
          <text class="label-hand motto" x={scene.mottoAt?.x ?? W - 18} y={scene.mottoAt?.y ?? H - 12} text-anchor={scene.mottoAt?.anchor ?? 'end'} aria-hidden="true">{scene.motto}</text>
          {scene.nodes.filter((n) => n.kind === 'frame').map((n) => (
            <g class="frame-g" data-node={n.id}>
              <rect class="frame draw-on" x={n.x} y={n.y} width={n.w} height={n.h} rx="3" filter={`url(#${uid}-ink)`} style={`--len:${2 * ((n.w ?? 0) + (n.h ?? 0))}`} />
              <rect class="frame-inner" x={n.x + 5} y={n.y + 5} width={(n.w ?? 0) - 10} height={(n.h ?? 0) - 10} rx="1" />
              <path class="frame-corners" d={cornerpieces(n.x, n.y, n.w ?? 0, n.h ?? 0)} />
              <text class="caps frame-title" x={n.x + 18} y={n.y + 26}>{n.label}</text>
            </g>
          ))}
          {scene.flows.map((fl) => {
            const g = geometry(scene, fl);
            return (
              <g class="flow-g" data-flow={fl.id} data-from={fl.from} data-to={fl.to}>
                <path class={`flow-line${fl.dashed ? ' dashed' : ''}`} d={g.d} marker-start={`url(#${uid}-prick)`} marker-end={`url(#${uid}-arrow)`} style={`--len:${g.len}`} />
                {particles && <circle class="particle" r="3"><animateMotion dur="2.4s" repeatCount="indefinite" path={g.d} /></circle>}
              </g>
            );
          })}
          {scene.nodes.filter((n) => n.kind !== 'frame').map((n) => {
            const c = center(n);
            const label = n.label;
            if (n.kind === 'dot') {
              return (
                <g class="node dot" data-node={n.id} tabindex="0" role="button" aria-label={label}>
                  <circle class="hit" cx={n.x} cy={n.y} r={(n.r ?? 8) + 9} />
                  <circle class="box" cx={n.x} cy={n.y} r={n.r ?? 8} />
                  <circle class="boss" cx={n.x} cy={n.y} r={(n.r ?? 8) - 3.2} />
                  <circle class="pip" cx={n.x} cy={n.y} r="3" />
                  <text class="node-label" x={n.x + (n.lx ?? 0)} y={n.y + (n.ly ?? 0)} text-anchor={n.anchor ?? 'middle'}>{label}</text>
                </g>
              );
            }
            const w = n.w ?? 0;
            const h = n.h ?? 0;
            const ty = c.y + (n.sub ? -3 : 5);
            const tx = c.x + (n.kind === 'tab' ? 4 : 0);
            return (
              <g class={`node ${n.kind}${n.dashed ? ' dashed' : ''}`} data-node={n.id} tabindex="0" role="button" aria-label={n.sub ? `${label}: ${n.sub}` : label}>
                {n.kind === 'box' && (
                  <>
                    <rect class="shade" x={n.x + 4.5} y={n.y + 4.5} width={w} height={h} rx="2" fill={`url(#${uid}-hatch)`} />
                    <rect class="box draw-on" x={n.x} y={n.y} width={w} height={h} rx="2" style={`--len:${2 * (w + h)}`} />
                    <rect class="rule" x={n.x + 3.5} y={n.y + 3.5} width={w - 7} height={h - 7} rx="1" />
                    <path class="ticks" d={overshoot(n.x, n.y, w, h)} />
                  </>
                )}
                {n.kind === 'store' && (
                  <>
                    <rect class="shade" x={n.x + ROLL / 2 + 4.5} y={n.y + 4.5} width={w - ROLL} height={h} fill={`url(#${uid}-hatch)`} />
                    <rect class="box draw-on" x={n.x + ROLL / 2} y={n.y} width={w - ROLL} height={h} style={`--len:${2 * (w + h)}`} />
                    <path class="rule" d={`M${n.x + ROLL + 4} ${n.y + 4.5}H${n.x + w - ROLL - 4}M${n.x + ROLL + 4} ${n.y + h - 4.5}H${n.x + w - ROLL - 4}`} />
                    {scroll(n.x, n.y, w, h).map((r) => (
                      <g class="roll">
                        <path class="roll-body" d={r.body} />
                        <path class="roll-shade" d={r.shade} fill={`url(#${uid}-hatch)`} />
                        <path class="roll-end" d={r.end} />
                        <path class="roll-fine" d={r.curl + r.knobs} />
                      </g>
                    ))}
                  </>
                )}
                {n.kind === 'tab' && (
                  <>
                    <path class="box draw-on" d={tagPath(n.x, n.y, w, h)} style={`--len:${2 * (w + h)}`} />
                    <circle class="eyelet" cx={n.x + 8.5} cy={n.y + h / 2} r="2" />
                  </>
                )}
                <text class={n.kind === 'tab' ? 'node-label mono' : 'node-label'} x={tx} y={n.kind === 'tab' ? c.y + 5 : ty} text-anchor="middle">{label}</text>
                {n.sub && <text class="node-sub" x={tx} y={ty + 17} text-anchor="middle">{n.sub}</text>}
              </g>
            );
          })}
          {/* Flow labels last, over the boxes, each with its halo of paper: a box drawn later never hides one. */}
          <g class="flow-labels" aria-hidden="true">
            {scene.flows.filter((fl) => fl.label).map((fl) => {
              const g = geometry(scene, fl);
              return <text class="flow-label" data-label-for={fl.id} x={f(g.lx + (fl.ldx ?? 0))} y={f(g.ly + (fl.ldy ?? 0))} text-anchor="middle">{fl.label}</text>;
            })}
          </g>
        </g>
      ))}
    </svg>
  </div>
  <div class="study-steps">
    <button type="button" class="ink-btn" data-step="prev" aria-label="Previous step">◀</button>
    <span class="step-count" aria-live="polite">Tour</span>
    <button type="button" class="ink-btn" data-step="next" aria-label="Next step">▶</button>
    <button type="button" class="ink-btn" data-step="play">Play the tour</button>
    <button type="button" class="ink-btn" data-step="reset">Show all</button>
  </div>
  <div class="study-note inkmap-note" aria-live="polite">
    <h4>{first.name}</h4>
    <p>{first.intro}</p>
  </div>
  <script type="application/json" class="inkmap-data" set:html={payload} />
</figure>

<style>
  .inkmap-svg .frame {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .inkmap-svg .frame-inner {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.55;
    opacity: 0.55;
  }
  .inkmap-svg .frame-corners {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.6;
  }
  .inkmap-svg .plate {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.3;
  }
  .inkmap-svg .frame-title {
    fill: var(--ink-2);
    font-size: 14px;
  }
  .inkmap-svg .node .box {
    fill: color-mix(in srgb, var(--paper) 72%, var(--paper-2));
    stroke: currentColor;
    stroke-width: 1.3;
    transition: stroke 0.2s, fill 0.2s;
  }
  .inkmap-svg .node.dashed .box {
    stroke-dasharray: 5 4;
  }
  .inkmap-svg .node.tab .box {
    fill: color-mix(in srgb, var(--paper-2) 80%, var(--paper));
  }
  .inkmap-svg .node .shade {
    opacity: 0.8;
  }
  .inkmap-svg .node .rule {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.5;
    opacity: 0.45;
    pointer-events: none;
  }
  /* By candlelight a bright double rule on a dark box reads as a screen's card, not a drawing: let it recede. */
  :global(:root[data-theme='lucerna']) .inkmap-svg :is(.node .rule, .frame-inner) {
    opacity: 0.26;
  }
  .inkmap-svg .node .ticks {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.5;
    pointer-events: none;
  }
  .inkmap-svg .roll-body {
    fill: var(--paper-2);
    stroke: currentColor;
    stroke-width: 1.15;
    transition: stroke 0.2s;
  }
  .inkmap-svg .roll-end {
    fill: var(--paper-3);
    stroke: currentColor;
    stroke-width: 1;
    transition: stroke 0.2s;
  }
  .inkmap-svg .roll-shade {
    stroke: none;
  }
  .inkmap-svg .roll-fine {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.65;
    stroke-linecap: round;
  }
  .inkmap-svg .eyelet {
    fill: var(--paper-2);
    stroke: currentColor;
    stroke-width: 0.8;
  }
  .inkmap-svg .node.dot .boss {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.5;
    opacity: 0.55;
  }
  .inkmap-svg .node-label {
    font-size: 17px;
    fill: var(--ink);
  }
  .inkmap-svg .node-label.mono {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .inkmap-svg .node-sub {
    font-size: 13.5px;
    font-style: italic;
    fill: var(--ink-2);
  }
  .inkmap-svg .node.dot .node-label {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--paper-2);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .inkmap-svg :global(.ring) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    opacity: 0.75;
  }
  .inkmap-svg :global(.ring-fine) {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.5;
  }
  .inkmap-svg :global(.ring-ticks) {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.55;
  }
  .inkmap-svg :global(.ring-arrow) {
    fill: none;
    stroke: var(--sanguine-2);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .inkmap-svg .node.dot .pip {
    fill: var(--sanguine-2);
    opacity: 0;
  }
  .inkmap-svg .node.dot .hit {
    fill: transparent;
  }
  .inkmap-svg .node {
    cursor: pointer;
    outline: none;
  }
  .inkmap-svg .node:hover .box,
  .inkmap-svg .node:focus-visible .box,
  .inkmap-svg .node:hover :is(.roll-body, .roll-end),
  .inkmap .inkmap-svg .node.lit :is(.roll-body, .roll-end) {
    stroke: var(--sanguine);
  }
  .inkmap-svg .node:focus-visible .box {
    stroke-width: 2.2;
    stroke-dasharray: 4 3;
  }
  .inkmap-svg .flow-line {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.25;
    opacity: 0.75;
    transition: stroke 0.25s, opacity 0.25s;
  }
  .inkmap-svg .flow-line.dashed {
    stroke-dasharray: 5 4;
  }
  /* A busy scene names only the flows a step lights; this outranks the dimming of a focused map below. */
  .inkmap .inkmap-svg .scene[data-quiet='true'] .flow-label:not(.lit) {
    opacity: 0;
  }
  .inkmap-svg .flow-label {
    transition: opacity 0.25s;
    font-size: 13px;
    font-style: italic;
    fill: var(--ink-3);
    paint-order: stroke;
    stroke: var(--paper-2);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .inkmap-svg .particle {
    fill: var(--sanguine-2);
    display: none;
  }
  .inkmap-svg .motto {
    opacity: 0.55;
  }
  .inkmap-svg .emblem {
    opacity: 0.6;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .inkmap.focused .inkmap-svg .emblem {
    opacity: 0.2;
  }
  .inkmap-svg .emblem-label {
    font-size: 17px;
    opacity: 0.85;
  }
  /* Lit: the parts a step or a chosen node is about. Everything else steps back. */
  .inkmap.focused .inkmap-svg .node:not(.lit),
  .inkmap.focused .inkmap-svg .flow-g:not(.lit),
  .inkmap.focused .inkmap-svg .flow-label:not(.lit) {
    opacity: 0.3;
  }
  .inkmap .inkmap-svg .node,
  .inkmap .inkmap-svg .flow-g {
    transition: opacity 0.3s;
  }
  .inkmap .inkmap-svg .node.lit .box {
    stroke: var(--sanguine);
    stroke-width: 2.2;
    fill: color-mix(in srgb, var(--sanguine) 10%, var(--paper));
  }
  .inkmap .inkmap-svg .node.dot.lit .pip {
    opacity: 1;
  }
  .inkmap .inkmap-svg .flow-g.lit .flow-line {
    stroke: var(--sanguine-2);
    stroke-width: 2;
    opacity: 1;
  }
  .inkmap .inkmap-svg .flow-label.lit {
    fill: var(--sanguine);
  }
  @media (prefers-reduced-motion: no-preference) {
    .inkmap .inkmap-svg .flow-g.lit .flow-line:not(.dashed) {
      stroke-dasharray: 6 5;
      animation: inkmap-run 0.9s linear infinite;
    }
    @keyframes inkmap-run {
      to {
        stroke-dashoffset: -22;
      }
    }
    .inkmap[data-particles='on'] .inkmap-svg .flow-g.lit .particle,
    .inkmap[data-particles='on']:not(.focused) .inkmap-svg .flow-g .particle {
      display: inline;
    }
  }
  .study-steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }
  .step-count {
    min-width: 4.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .inkmap-note :global(ul) {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
  }
  .inkmap-note :global(li + li) {
    margin-top: 0.25rem;
  }
  .inkmap-note :global(code) {
    font-size: 0.82em;
  }
</style>

<script>
  import { reveal } from '../scripts/study-scroll';

  type Step = { title: string; text: string; on: string[]; flows?: string[] };
  type SceneData = {
    id: string;
    name: string;
    intro: string;
    steps: Step[];
    hooks: Record<string, { name: string; does: string }[]> | null;
    nodes: Record<string, { label: string; sub: string; info: string }>;
    flows: { id: string; from: string; to: string; label: string }[];
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[m]!);

  for (const fig of document.querySelectorAll<HTMLElement>('.inkmap')) {
    const scenes: SceneData[] = JSON.parse(fig.querySelector('.inkmap-data')!.textContent!);
    const note = fig.querySelector<HTMLElement>('.inkmap-note')!;
    const count = fig.querySelector<HTMLElement>('.step-count')!;
    const playBtn = fig.querySelector<HTMLButtonElement>('[data-step="play"]')!;
    let scene = scenes.find((s) => s.id === fig.dataset.scene) ?? scenes[0];
    let step = -1;
    let timer = 0;

    const group = () => fig.querySelector<SVGGElement>(`.scene[data-scene="${scene.id}"]`)!;
    const clear = () => {
      fig.classList.remove('focused');
      for (const el of group().querySelectorAll('.lit')) el.classList.remove('lit');
    };
    const light = (nodes: string[], flows: string[]) => {
      clear();
      fig.classList.add('focused');
      const g = group();
      for (const id of nodes) g.querySelector(`[data-node="${id}"]`)?.classList.add('lit');
      for (const id of flows) for (const el of g.querySelectorAll(`[data-flow="${id}"], [data-label-for="${id}"]`)) el.classList.add('lit');
    };
    const intro = () => {
      note.innerHTML = `<h4>${esc(scene.name)}</h4><p>${esc(scene.intro)}</p>`;
      count.textContent = `Tour · ${scene.steps.length} steps`;
    };
    function stop() {
      clearInterval(timer);
      timer = 0;
      playBtn.textContent = 'Play the tour';
      playBtn.setAttribute('aria-pressed', 'false');
    }
    function go(i: number) {
      step = Math.max(0, Math.min(scene.steps.length - 1, i));
      const s = scene.steps[step];
      light(s.on, s.flows ?? []);
      reveal(group().querySelectorAll('.node.lit'));
      count.textContent = `${step + 1} / ${scene.steps.length}`;
      note.innerHTML = `<h4>${step + 1}. ${esc(s.title)}</h4><p>${esc(s.text)}</p>`;
    }
    function show(id: string) {
      stop();
      scene = scenes.find((s) => s.id === id) ?? scene;
      fig.dataset.scene = scene.id;
      for (const g of fig.querySelectorAll<SVGGElement>('.scene')) {
        if (g.dataset.scene === scene.id) g.removeAttribute('display');
        else g.setAttribute('display', 'none');
      }
      for (const b of fig.querySelectorAll<HTMLButtonElement>('[data-show]')) b.setAttribute('aria-selected', String(b.dataset.show === scene.id));
      step = -1;
      clear();
      intro();
    }
    function pick(id: string) {
      stop();
      const n = scene.nodes[id];
      if (!n) return;
      const touching = scene.flows.filter((fl) => fl.from === id || fl.to === id);
      const others = touching.map((fl) => (fl.from === id ? fl.to : fl.from));
      light([id, ...others], touching.map((fl) => fl.id));
      const hooks = scene.hooks?.[id];
      let html = `<h4>${esc(n.label)}${n.sub ? ` <small>· ${esc(n.sub)}</small>` : ''}</h4>`;
      if (n.info) html += `<p>${esc(n.info)}</p>`;
      if (hooks) html += `<ul>${hooks.map((h) => `<li><b>${esc(h.name)}</b>: ${esc(h.does)}</li>`).join('')}</ul>`;
      const outs = touching.filter((fl) => fl.label);
      if (outs.length && !hooks) html += `<p class="where">${outs.map((fl) => esc(`${scene.nodes[fl.from]?.label ?? fl.from} → ${scene.nodes[fl.to]?.label ?? fl.to}: ${fl.label}`)).join(' · ')}</p>`;
      note.innerHTML = html;
      count.textContent = 'Tour';
    }

    fig.addEventListener('click', (e) => {
      const t = e.target as Element;
      const tab = t.closest<HTMLButtonElement>('[data-show]');
      if (tab) return show(tab.dataset.show!);
      const btn = t.closest<HTMLButtonElement>('[data-step]');
      if (btn) {
        const what = btn.dataset.step;
        if (what === 'next') {
          stop();
          go(step + 1);
        } else if (what === 'prev') {
          stop();
          go(step - 1);
        } else if (what === 'reset') {
          stop();
          step = -1;
          clear();
          intro();
        } else if (what === 'play') {
          if (timer) return stop();
          go(step >= scene.steps.length - 1 ? 0 : step + 1);
          playBtn.textContent = 'Pause';
          playBtn.setAttribute('aria-pressed', 'true');
          timer = window.setInterval(() => {
            if (step >= scene.steps.length - 1) return stop();
            go(step + 1);
          }, 4200);
        }
        return;
      }
      const node = t.closest<SVGGElement>('.node');
      if (node) pick(node.dataset.node!);
    });
    fig.addEventListener('keydown', (e) => {
      const node = (e.target as Element).closest<SVGGElement>('.node');
      if (node && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        pick(node.dataset.node!);
      }
    });
    fig.addEventListener('focusin', (e) => {
      const node = (e.target as Element).closest<SVGGElement>('.node');
      if (node && (e.target as Element).matches(':focus-visible')) pick(node.dataset.node!);
    });
    // Tabs: arrow keys move between views, as a tablist should.
    fig.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
      const tabs = [...fig.querySelectorAll<HTMLButtonElement>('[data-show]')];
      const i = tabs.findIndex((b) => b.dataset.show === scene.id);
      const next = tabs[(i + (ev.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
      show(next.dataset.show!);
      next.focus();
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((x) => x.isIntersecting)) {
          fig.classList.add('drawn');
          io.disconnect();
        }
      }, { threshold: 0.25 });
      io.observe(fig);
    }
    intro();
  }
</script>
