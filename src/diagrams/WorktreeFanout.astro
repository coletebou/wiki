---
// Study: worktree fan-out. One `pw launch` drawn as a botanical study: the repository is the trunk, each manifest row
// grows a branch to its own worktree, the worktree is bootstrapped, its agent starts in a tmux window, and each
// summary lands in the merged log between sentinel lines. Choose how many lanes, launch, or pick a lane.
import { HATCH_TURN, overshoot, plate } from './ink';

const lanes = [
  { tag: 'search', branch: 'feat/search-filters', engine: 'claude', done: 'Filter chips and URL state; 14 tests pass.' },
  { tag: 'export', branch: 'feat/csv-export', engine: 'claude', done: 'CSV export with streaming rows; e2e green.' },
  { tag: 'docs', branch: 'docs/api-reference', engine: 'claude', done: 'Reference pages for 9 endpoints; links checked.' },
  { tag: 'audit', branch: 'review/security', engine: 'codex:sol:xhigh', done: '2 findings, both with repro steps; no fixes made.' },
  { tag: 'i18n', branch: 'feat/i18n-strings', engine: 'claude', done: 'Strings extracted to 3 locales; snapshots updated.' },
  { tag: 'perf', branch: 'perf/cold-start', engine: 'codex:luna:high', done: 'Cold start 1.9 s to 1.1 s; flame graphs attached.' },
];
const boot = ['.env', '.npmrc', '.envrc', 'npm install'];
const chipX = [0, 36, 86, 134];
const laneY = (i: number) => 92 + i * 60;
const trunkX = 262;
const branchFrom = (i: number) => laneY(i) + 46;
const data = JSON.stringify({ lanes, boot }).replace(/</g, '\\u003c');

// The tree, drawn as a botanical study: a trunk that tapers from its roots, ringed with bark and shaded on its right;
// branches that thicken where they leave it; leaves with a midrib and one hatched half.
type P = [number, number];
const r1 = (n: number) => Math.round(n * 10) / 10;
const xy = (p: P) => `${r1(p[0])} ${r1(p[1])}`;
const bez = (a: P, b: P, c: P, d: P, t: number): P => {
  const u = 1 - t;
  return [u * u * u * a[0] + 3 * u * u * t * b[0] + 3 * u * t * t * c[0] + t * t * t * d[0], u * u * u * a[1] + 3 * u * u * t * b[1] + 3 * u * t * t * c[1] + t * t * t * d[1]];
};
const TRUNK: [P, P, P, P] = [[trunkX, 452], [trunkX - 16, 352], [trunkX + 20, 210], [trunkX - 4, 100]];
const halfWidth = (t: number) => 4 + 7.4 * Math.pow(1 - t, 1.25) + (t < 0.1 ? Math.pow((0.1 - t) / 0.1, 2) * 9 : 0);
function tapered(curve: [P, P, P, P], w: (t: number) => number, n = 40) {
  const left: P[] = [];
  const right: P[] = [];
  const mid: P[] = [];
  for (let i = 0; i <= n; i++) {
    const t = i / n;
    const p = bez(...curve, t);
    const q = bez(...curve, Math.min(1, t + 0.01));
    const o = bez(...curve, Math.max(0, t - 0.01));
    const d = [q[0] - o[0], q[1] - o[1]];
    const l = Math.hypot(d[0], d[1]) || 1;
    const nrm: P = [-d[1] / l, d[0] / l];
    left.push([p[0] + nrm[0] * w(t), p[1] + nrm[1] * w(t)]);
    right.push([p[0] - nrm[0] * w(t), p[1] - nrm[1] * w(t)]);
    mid.push(p);
  }
  return { left, right, mid, outline: `M${left.map(xy).join('L')}L${right.slice().reverse().map(xy).join('L')}Z` };
}
const trunk = tapered(TRUNK, halfWidth);
// Its shaded half, toward the lower right, and the rings of bark across it.
const trunkShade = `M${trunk.mid.map(xy).join('L')}L${trunk.right.slice().reverse().map(xy).join('L')}Z`;
// Bark: short curved marks across one side or the other, never a ladder of rungs, and two fissures running up it.
const bark =
  trunk.mid
    .map((p, i) => ({ p, i }))
    .filter(({ i }) => i > 1 && i < 37 && i % 2 === 0)
    .map(({ i }, k) => {
      const [l, r] = [trunk.left[i], trunk.right[i]];
      const from = [0.1, 0.42, 0.22, 0.55, 0.05, 0.36][k % 6];
      const span = [0.4, 0.45, 0.3, 0.38, 0.5, 0.33][k % 6];
      const at = (f: number): P => [l[0] + (r[0] - l[0]) * f, l[1] + (r[1] - l[1]) * f];
      const a = at(from);
      const b = at(from + span);
      return `M${xy(a)}Q${xy([(a[0] + b[0]) / 2, (a[1] + b[1]) / 2 + 1.8])} ${xy(b)}`;
    })
    .join('') +
  [0.33, 0.7].map((f, j) => `M${trunk.mid.slice(2, 36).map((p, i) => xy([trunk.left[i + 2][0] + (trunk.right[i + 2][0] - trunk.left[i + 2][0]) * f + Math.sin(i * 1.1 + j) * 0.7, p[1]])).join('L')}`).join('');
// The crown: the trunk ends in a few twigs and leaves above the first branch, not in a cut-off pole.
const top = trunk.mid[trunk.mid.length - 1];
const crown = {
  twigs: [
    [[top[0] - 1, top[1] + 4], [top[0] - 6, top[1] - 4], [top[0] - 12, top[1] - 8], [top[0] - 20, top[1] - 9]],
    [[top[0] + 1, top[1] + 3], [top[0] + 4, top[1] - 5], [top[0] + 10, top[1] - 9], [top[0] + 17, top[1] - 12]],
    [[top[0], top[1] + 2], [top[0] + 1, top[1] - 4], [top[0] - 1, top[1] - 9], [top[0] + 1, top[1] - 15]],
  ].map((c) => tapered(c as [P, P, P, P], (t) => 1.4 * (1 - t) + 0.3, 10).outline),
};
// Where a branch leaves the trunk: the trunk's right edge at that height.
const trunkEdge = (y: number) => {
  let best = 0;
  trunk.right.forEach((p, i) => {
    if (Math.abs(p[1] - y) < Math.abs(trunk.right[best][1] - y)) best = i;
  });
  return Math.max(trunk.right[best][0], trunk.left[best][0]) - 1.2;
};
// Roots, each a tapering stroke into the ground, and the ground hatched under them.
const roots = ([
  [[trunkX - 12, 444], [trunkX - 24, 452], [trunkX - 40, 455], [trunkX - 58, 462]],
  [[trunkX + 12, 443], [trunkX + 24, 450], [trunkX + 36, 452], [trunkX + 52, 458]],
  [[trunkX - 6, 448], [trunkX - 12, 458], [trunkX - 20, 462], [trunkX - 30, 469]],
  [[trunkX + 6, 448], [trunkX + 12, 457], [trunkX + 18, 462], [trunkX + 26, 469]],
  [[trunkX, 450], [trunkX + 1, 458], [trunkX - 2, 464], [trunkX, 470]],
] as [P, P, P, P][]).map((c, i) => tapered(c, (t) => (i < 2 ? 4.2 : 3) * Math.pow(1 - t, 0.8) + 0.25, 16).outline);
// The ground, a few strokes of it, hatched under the roots where they go in.
const ground = Array.from({ length: 13 }, (_, i) => {
  const x = trunkX - 54 + i * 8.6 + (i % 3);
  return `M${r1(x)} ${462 + (i % 2) * 1.5}l4.2 6`;
}).join('');
// Each lane's branch: the curve it grows along, the thicker stretch where it leaves the trunk, and two leaves.
const branchCurve = (i: number): [P, P, P, P] => {
  const y = laneY(i);
  const fy = branchFrom(i);
  const x0 = trunkEdge(fy);
  return [[x0, fy], [x0 + 46, fy - 7], [trunkX + 60, y + 24], [380, y + 22]];
};
function split(c: [P, P, P, P], t: number): [P, P, P, P] {
  const lerp = (a: P, b: P): P => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
  const [a, b, cc, d] = c;
  const ab = lerp(a, b);
  const bc = lerp(b, cc);
  const cd = lerp(cc, d);
  const abc = lerp(ab, bc);
  const bcd = lerp(bc, cd);
  return [a, ab, abc, lerp(abc, bcd)];
}
const curveD = (c: [P, P, P, P]) => `M${xy(c[0])}C${xy(c[1])} ${xy(c[2])} ${xy(c[3])}`;
function leaf(at: P, deg: number, len: number) {
  const a = (deg * Math.PI) / 180;
  const v: P = [Math.cos(a), Math.sin(a)];
  const n: P = [-v[1], v[0]];
  const p = (u: number, w: number): P => [at[0] + v[0] * u * len + n[0] * w * len, at[1] + v[1] * u * len + n[1] * w * len];
  // A stalk, then the blade: broad near its base, drawn out to a point.
  const blade = `M${xy(p(0.12, 0))}C${xy(p(0.3, 0.3))} ${xy(p(0.72, 0.27))} ${xy(p(1, 0))}C${xy(p(0.72, -0.22))} ${xy(p(0.3, -0.27))} ${xy(p(0.12, 0))}Z`;
  const half = `M${xy(p(0.12, 0))}C${xy(p(0.3, 0.3))} ${xy(p(0.72, 0.27))} ${xy(p(1, 0))}Z`;
  const veins = `M${xy(p(0, 0))}L${xy(p(0.93, 0))}` + [0.32, 0.5, 0.68, 0.82].map((u) => `M${xy(p(u, 0))}Q${xy(p(u + 0.06, 0.1))} ${xy(p(u + 0.12, 0.2 - (u - 0.3) * 0.25))}M${xy(p(u, 0))}Q${xy(p(u + 0.06, -0.09))} ${xy(p(u + 0.12, -0.18 + (u - 0.3) * 0.22))}`).join('');
  return { blade, half, veins };
}
const branches = lanes.map((_, i) => {
  const c = branchCurve(i);
  const up = leaf(bez(...c, 0.28), -58 - (i % 3) * 7, 21);
  const down = leaf(bez(...c, 0.6), 32 + (i % 2) * 10, 16);
  return { d: curveD(c), base: curveD(split(c, 0.22)), mid: curveD(split(c, 0.5)), leaves: [up, down] };
});
const crownLeaves = [leaf([top[0] - 20, top[1] - 9], -150, 13), leaf([top[0] + 17, top[1] - 12], -28, 13), leaf([top[0] + 1, top[1] - 15], -92, 12)];
const sheet = plate(800, 470);
---
<figure class="study fanout" data-pagefind-ignore data-lanes="4" aria-labelledby="wf-title">
  <figcaption class="study-head">
    <p class="study-title" id="wf-title"><b>Studium</b>Worktree fan-out</p>
    <p class="study-hint">Choose how many lanes, press Launch, or pick a lane to see what it gets.</p>
  </figcaption>
  <div class="study-tools">
    <button type="button" class="ink-btn" data-lanes="-1" aria-label="One lane fewer">−</button>
    <span class="wf-count" aria-live="polite">4 lanes</span>
    <button type="button" class="ink-btn" data-lanes="1" aria-label="One lane more">+</button>
    <button type="button" class="ink-btn" data-launch>Launch <kbd>pw launch m.tsv</kbd></button>
    <button type="button" class="ink-btn" data-reset>Reset</button>
  </div>
  <div class="study-scroll">
    <svg class="study-svg wf-svg" viewBox="0 0 800 470" role="group" aria-label="One launch of parallel worktrees" style="min-width: 660px">
      <defs>
        <pattern id="wf-hatch" width="3.6" height="3.6" patternUnits="userSpaceOnUse" patternTransform={`rotate(${HATCH_TURN})`}>
          <line x1="0" y1="0" x2="0" y2="3.6" stroke="currentColor" stroke-width="0.75" opacity="0.5" />
        </pattern>
        <filter id="wf-ink" x="-3%" y="-3%" width="106%" height="106%">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="11" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="1.7" />
        </filter>
      </defs>

      <g class="wf-plate" aria-hidden="true">
        <path d={sheet.ticks} />
        <path d={sheet.corners} />
      </g>
      <text class="label-hand wf-motto" x="20" y="462" aria-hidden="true">de arboribus</text>
      <text class="caps wf-head" x="20" y="74">The manifest</text>
      <text class="caps wf-head" x="240" y="74">The repository</text>
      <text class="caps wf-head" x="380" y="74">Worktrees</text>
      <text class="caps wf-head" x="596" y="74">Window 0 · the merged log</text>

      <g class="wf-tabs">
        <g class="wf-tab log-tab">
          <rect x="20" y="16" width="70" height="26" rx="2" />
          <text x="55" y="34" text-anchor="middle">0:log</text>
        </g>
        {lanes.map((l, i) => (
          <g class="wf-tab lane-tab" data-lane={i}>
            <rect x={96 + i * 84} y="16" width="80" height="26" rx="2" />
            <text x={136 + i * 84} y="34" text-anchor="middle">{i + 1}:{l.tag}</text>
          </g>
        ))}
      </g>

      <g class="wf-tree" aria-hidden="true">
        <path class="ground" d={ground} />
        {roots.map((d) => <path class="root" d={d} filter="url(#wf-ink)" />)}
        <path class="trunk" d={trunk.outline} filter="url(#wf-ink)" />
        <path class="trunk-shade" d={trunkShade} fill="url(#wf-hatch)" />
        <path class="bark" d={bark} />
        {crown.twigs.map((d) => <path class="root" d={d} />)}
        {crownLeaves.map((lf) => (
          <g class="crown-leaf">
            <path class="leaf-blade" d={lf.blade} />
            <path class="leaf-half" d={lf.half} fill="url(#wf-hatch)" />
            <path class="leaf-veins" d={lf.veins} />
          </g>
        ))}
      </g>
      <text class="wf-root" x={trunkX + 58} y="466">origin/HEAD</text>

      {lanes.map((l, i) => {
        const y = laneY(i);
        const fy = branchFrom(i);
        return (
          <g class="lane" data-lane={i} tabindex="0" role="button" aria-label={`Lane ${l.tag}: branch ${l.branch}, engine ${l.engine}`}>
            <g class="row">
              <rect class="row-box" x="16" y={y - 2} width="214" height="50" rx="2" />
              <path class="row-rule" d={`M22 ${y + 4}V${y + 42}`} />
              <text class="row-tag" x="28" y={y + 18}>{l.tag}</text>
              <text class={`row-engine ${l.engine.startsWith('codex') ? 'codex' : ''}`} x="218" y={y + 18} text-anchor="end">{l.engine}</text>
              <text class="row-branch" x="28" y={y + 37}>{l.branch}</text>
            </g>
            <path class="branch-base" d={branches[i].base} />
            <path class="branch-base mid" d={branches[i].mid} />
            <path class="branch" d={branches[i].d} />
            {branches[i].leaves.map((lf) => (
              <g class="leaf">
                <path class="leaf-blade" d={lf.blade} />
                <path class="leaf-half" d={lf.half} fill="url(#wf-hatch)" />
                <path class="leaf-veins" d={lf.veins} />
              </g>
            ))}
            <g class="tree">
              <rect class="tree-shade" x="384.5" y={y + 2.5} width="196" height="46" rx="2" fill="url(#wf-hatch)" />
              <rect class="tree-box" x="380" y={y - 2} width="196" height="46" rx="2" />
              <rect class="tree-rule" x="383.5" y={y + 1.5} width="189" height="39" rx="1" />
              <path class="tree-ticks" d={overshoot(380, y - 2, 196, 46, 4, 5)} />
              <text class="tree-path" x="392" y={y + 17}>.claude/worktrees/{l.tag}</text>
              <g class="chips">
                {boot.map((b, j) => (
                  <text class="chip" data-chip={j} x={392 + chipX[j]} y={y + 35}>{b === 'npm install' ? 'npm i' : b}</text>
                ))}
              </g>
              <circle class="agent" cx="562" cy={y + 21} r="7" />
              <text class="agent-mark" x="562" y={y + 25.5} text-anchor="middle">{l.engine.startsWith('codex') ? '◎' : '✻'}</text>
            </g>
          </g>
        );
      })}

      {/* The merged log, a scroll: rolled at its head and its foot. */}
      <rect class="log-box" x="596" y="92" width="188" height="358" />
      <g class="log-rolls" aria-hidden="true">
        {[86, 452].map((ry) => (
          <g>
            <path class="log-roll" d={`M592 ${ry - 6}H788V${ry + 6}H592Z`} />
            <path class="log-roll-shade" d={`M592 ${ry + 1.5}H788V${ry + 6}H592Z`} fill="url(#wf-hatch)" />
            <ellipse class="log-roll-end" cx="592" cy={ry} rx="2.4" ry="6" />
            <ellipse class="log-roll-end" cx="788" cy={ry} rx="2.4" ry="6" />
            <path class="log-roll-fine" d={`M589.6 ${ry}h-4M790.4 ${ry}h4M592 ${ry - 2.6}a1 2.6 0 0 0 0 5.2a1 2.6 0 0 0 0 -5.2`} />
          </g>
        ))}
      </g>
      <g class="log-lines"></g>
    </svg>
  </div>
  <div class="study-note wf-note" aria-live="polite">
    <h4>One launch</h4>
    <p>Each row of the manifest names a lane: a tag, a branch, the prompt and, if you like, the engine. Press Launch to watch <code>pw</code> turn rows into worktrees, worktrees into tmux windows, and finished work into the merged log.</p>
  </div>
  <script type="application/json" class="wf-data" set:html={data} />
</figure>

<style>
  .wf-svg .wf-head {
    font-size: 11.5px;
    fill: var(--ink-3);
  }
  .wf-svg .wf-tab rect {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 1;
    transition: opacity 0.3s, fill 0.3s;
  }
  .wf-svg .wf-tab text {
    font-family: var(--font-mono);
    font-size: 11.5px;
    fill: var(--ink-2);
  }
  .wf-svg .wf-tab.log-tab rect {
    fill: color-mix(in srgb, var(--sanguine) 12%, var(--paper));
  }
  .wf-svg .wf-plate {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.3;
  }
  .wf-svg .wf-motto {
    opacity: 0.55;
  }
  .wf-svg .trunk,
  .wf-svg .root {
    fill: var(--paper-2);
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .wf-svg .trunk-shade {
    stroke: none;
  }
  .wf-svg .bark,
  .wf-svg .ground {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    stroke-linecap: round;
    opacity: 0.6;
  }
  .wf-svg .wf-root {
    font-family: var(--font-mono);
    font-size: 11.5px;
    fill: var(--ink-2);
  }
  .wf-svg .lane {
    cursor: pointer;
    outline: none;
  }
  .wf-svg .row-box {
    fill: var(--paper);
    stroke: var(--rule);
    stroke-width: 1;
  }
  .wf-svg .row-rule {
    stroke: var(--sanguine-2);
    stroke-width: 0.6;
    opacity: 0.6;
  }
  .wf-svg .row-tag {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    fill: var(--ink);
  }
  .wf-svg .row-engine {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-3);
  }
  .wf-svg .row-engine.codex {
    fill: var(--verdigris);
  }
  .wf-svg .row-branch {
    font-family: var(--font-mono);
    font-size: 11.5px;
    fill: var(--ink-2);
  }
  .wf-svg .branch,
  .wf-svg .branch-base {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    transition: stroke-dashoffset 0.9s ease-out, stroke 0.2s;
  }
  /* Where a branch leaves the trunk it is thicker: a second, shorter stroke that grows with it. */
  .wf-svg .branch-base {
    stroke-width: 3.1;
    stroke-dasharray: 110;
    stroke-dashoffset: 110;
    transition-duration: 0.35s, 0.2s;
  }
  .wf-svg .branch-base.mid {
    stroke-width: 2.2;
    stroke-dasharray: 160;
    stroke-dashoffset: 160;
    transition-duration: 0.55s, 0.2s;
  }
  .wf-svg .leaf {
    opacity: 0;
    transition: opacity 0.4s 0.5s;
  }
  .wf-svg .leaf-blade {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 0.8;
  }
  .wf-svg .leaf-half {
    stroke: none;
  }
  .wf-svg .leaf-veins {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.5;
    stroke-linecap: round;
  }
  .wf-svg .tree {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .wf-svg .tree-box {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 1.2;
  }
  .wf-svg .tree-rule,
  .wf-svg .tree-ticks {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.5;
    opacity: 0.45;
  }
  .wf-svg .tree-path {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink);
  }
  .wf-svg .chip {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--ink-3);
    opacity: 0.25;
    transition: opacity 0.25s, fill 0.25s;
  }
  .wf-svg .agent {
    fill: var(--paper-2);
    stroke: currentColor;
    stroke-width: 1;
  }
  .wf-svg .agent-mark {
    font-size: 11px;
    fill: var(--ink-3);
  }
  .wf-svg .log-box {
    fill: color-mix(in srgb, var(--paper) 70%, var(--code-bg));
    stroke: currentColor;
    stroke-width: 1.1;
  }
  .wf-svg .log-roll {
    fill: var(--paper-2);
    stroke: currentColor;
    stroke-width: 1.1;
  }
  .wf-svg .log-roll-shade {
    stroke: none;
  }
  .wf-svg .log-roll-end {
    fill: var(--paper-3);
    stroke: currentColor;
    stroke-width: 0.9;
  }
  .wf-svg .log-roll-fine {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    stroke-linecap: round;
  }
  .wf-svg :global(.log-line) {
    font-family: var(--font-mono);
    font-size: 9.4px;
    fill: var(--ink-2);
  }
  .wf-svg :global(.log-line.sentinel) {
    fill: var(--sanguine);
  }
  .wf-svg :global(.log-line.summary) {
    fill: var(--ink);
    font-family: var(--font-text);
    font-size: 11.5px;
    font-style: italic;
  }
  /* States: which lanes exist, which have grown, which are working or done. */
  .wf-svg .lane-tab {
    opacity: 0;
  }
  .wf-svg .lane.grown :is(.branch, .branch-base) {
    stroke-dashoffset: 0;
  }
  .wf-svg .lane.grown .leaf,
  .wf-svg .lane.grown .tree {
    opacity: 1;
  }
  .wf-svg .lane .chip.on {
    opacity: 1;
    fill: var(--ink-2);
  }
  .wf-svg .lane.working .agent {
    fill: color-mix(in srgb, var(--sanguine) 25%, var(--paper));
    stroke: var(--sanguine);
  }
  .wf-svg .lane.working .agent-mark {
    fill: var(--sanguine);
  }
  .wf-svg .lane.done .agent {
    fill: var(--verdigris);
    stroke: var(--verdigris);
  }
  .wf-svg .lane.done .agent-mark {
    fill: var(--paper);
  }
  .wf-svg .lane-tab.open {
    opacity: 1;
  }
  .wf-svg .lane.picked .row-box,
  .wf-svg .lane.picked .tree-box {
    stroke: var(--sanguine);
    stroke-width: 2;
  }
  .wf-svg .lane.picked :is(.branch, .branch-base) {
    stroke: var(--sanguine-2);
  }
  .wf-svg .lane:focus-visible .row-box {
    stroke: var(--sanguine);
    stroke-dasharray: 4 3;
    stroke-width: 2;
  }
  .wf-svg .lane-tab.picked rect {
    stroke: var(--sanguine);
    stroke-width: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .wf-svg .branch,
    .wf-svg .branch-base,
    .wf-svg .leaf,
    .wf-svg .tree,
    .wf-svg .chip {
      transition: none;
    }
  }
  .wf-count {
    min-width: 4.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .wf-note :global(code) {
    font-size: 0.82em;
  }
</style>

<script>
  import { reveal } from '../scripts/study-scroll';

  type Lane = { tag: string; branch: string; engine: string; done: string };
  const NS = 'http://www.w3.org/2000/svg';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (s: string) => s.replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[m]!);

  for (const fig of document.querySelectorAll<HTMLElement>('.fanout')) {
    const { lanes, boot }: { lanes: Lane[]; boot: string[] } = JSON.parse(fig.querySelector('.wf-data')!.textContent!);
    const note = fig.querySelector<HTMLElement>('.wf-note')!;
    const count = fig.querySelector<HTMLElement>('.wf-count')!;
    const logLines = fig.querySelector<SVGGElement>('.log-lines')!;
    const laneEls = [...fig.querySelectorAll<SVGGElement>('.lane')];
    const tabs = [...fig.querySelectorAll<SVGGElement>('.lane-tab')];
    let timers: number[] = [];
    let lines: { text: string; cls: string }[] = [];

    const n = () => Number(fig.dataset.lanes);
    const say = (title: string, html: string) => (note.innerHTML = `<h4>${esc(title)}</h4><p>${html}</p>`);
    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, reduced ? 0 : ms));

    function drawLog() {
      logLines.replaceChildren();
      const shown = lines.slice(-27);
      shown.forEach((l, i) => {
        const t = document.createElementNS(NS, 'text');
        t.setAttribute('x', '602');
        t.setAttribute('y', String(106 + i * 13));
        t.setAttribute('class', `log-line ${l.cls}`);
        t.textContent = l.text.length > 32 ? `${l.text.slice(0, 31)}…` : l.text;
        logLines.append(t);
      });
    }
    function log(text: string, cls = '') {
      lines.push({ text, cls });
      drawLog();
    }
    function reset() {
      timers.forEach(clearTimeout);
      timers = [];
      lines = [];
      drawLog();
      for (const el of laneEls) el.classList.remove('grown', 'working', 'done', 'picked');
      for (const c of fig.querySelectorAll('.chip')) c.classList.remove('on');
      for (const t of tabs) t.classList.remove('open', 'picked');
    }
    function setLanes(k: number) {
      fig.dataset.lanes = String(Math.max(1, Math.min(lanes.length, k)));
      count.textContent = `${n()} lane${n() === 1 ? '' : 's'}`;
      reset();
      laneEls.forEach((el, i) => el.setAttribute('display', i < n() ? 'inline' : 'none'));
      tabs.forEach((el, i) => el.setAttribute('display', i < n() ? 'inline' : 'none'));
      say('One launch', `${n()} row${n() === 1 ? '' : 's'} in the manifest, so ${n()} worktree${n() === 1 ? '' : 's'}, ${n()} tmux window${n() === 1 ? '' : 's'} and one log. Press Launch.`);
    }
    function launch() {
      reset();
      const k = n();
      say('pw validate', 'Every prompt file exists and ends with the log footer; a missing one stops the launch before any worktree is made.');
      log('# run started · transcripts:', 'sentinel');
      for (let i = 0; i < k; i++) log(`#  ${lanes[i].tag}: …/${lanes[i].tag}.jsonl`);
      let t = 700;
      for (let i = 0; i < k; i++) {
        const el = laneEls[i];
        later(t, () => {
          el.classList.add('grown');
          reveal(el.querySelectorAll('.tree'));
          say(`Lane ${i + 1}: a worktree`, `<code>wt-helper</code> branches <code>${esc(lanes[i].branch)}</code> from <code>origin/HEAD</code> into <code>.claude/worktrees/${esc(lanes[i].tag)}</code>, git-ignored inside the repository.`);
        });
        boot.forEach((b, j) => later(t + 500 + j * 160, () => el.querySelector(`[data-chip="${j}"]`)?.classList.add('on')));
        later(t + 520, () => say(`Lane ${i + 1}: the bootstrap`, 'A fresh checkout lacks every ignored file, so <code>pw</code> copies the ones that exist (<code>.env</code>, <code>.env.keys</code>, <code>.env.local</code>, <code>.npmrc</code>, <code>.nvmrc</code> and a few more), writes an <code>.envrc</code> with <code>COMPOSE_PROJECT_NAME</code>, and runs <code>npm install</code>.'));
        later(t + 1500, () => {
          tabs[i].classList.add('open');
          el.classList.add('working');
          say(`Lane ${i + 1}: a window and an agent`, `Window ${i + 1} exports the lane's details and starts ${lanes[i].engine.startsWith('codex') ? 'Codex' : 'Claude Code'} with a fixed session id and the prompt as its first message.`);
        });
        t += reduced ? 0 : 1300;
      }
      const order = Array.from({ length: k }, (_, i) => i).sort((a, b) => ((a * 7 + 3) % 5) - ((b * 7 + 3) % 5));
      let d = t + 1400;
      for (const i of order) {
        later(d, () => {
          laneEls[i].classList.remove('working');
          laneEls[i].classList.add('done');
          log(`<<SESSION tag=${lanes[i].tag} branch=${lanes[i].branch}>>`, 'sentinel');
          log(lanes[i].done, 'summary');
          log(`<<END SESSION ${lanes[i].tag}>>`, 'sentinel');
          reveal(fig.querySelectorAll('.log-box'));
          say(`${lanes[i].tag} finished`, `Its footer piped the summary into <code>pw-append</code>, which takes a <code>mkdir</code> lock first, so two lanes that finish together never interleave. A merge agent can pull one lane out with a single <code>grep</code>.`);
        });
        d += reduced ? 0 : 1100;
      }
      later(d + 200, () => say('All lanes in', `${k} summaries in window 0, each between its sentinels. <code>pw log</code> follows it; <code>pw teardown</code> removes the worktrees when you are done, and the branches too with <code>--delete-branches</code>.`));
    }
    function pick(i: number) {
      for (const el of laneEls) el.classList.toggle('picked', Number(el.dataset.lane) === i);
      for (const t of tabs) t.classList.toggle('picked', Number(t.dataset.lane) === i);
      const l = lanes[i];
      say(
        `Lane ${i + 1} · ${l.tag}`,
        `Branch <code>${esc(l.branch)}</code>, worktree <code>.claude/worktrees/${esc(l.tag)}</code>, tmux window <code>${i + 1}:${esc(l.tag)}</code>, engine <code>${esc(l.engine)}</code>. The window exports <code>PARALLEL_TAG</code>, <code>PARALLEL_BRANCH</code>, <code>PARALLEL_LOG</code>, <code>PARALLEL_APPEND</code> and <code>COMPOSE_PROJECT_NAME=app-${esc(l.tag)}</code>, so the lane's Docker Compose project never collides with the main checkout's.`,
      );
    }

    fig.addEventListener('click', (e) => {
      const t = e.target as Element;
      const step = t.closest<HTMLButtonElement>('[data-lanes]');
      if (step && step.tagName === 'BUTTON') return setLanes(n() + Number(step.dataset.lanes));
      if (t.closest('[data-launch]')) return launch();
      if (t.closest('[data-reset]')) return setLanes(n());
      const lane = t.closest<SVGGElement>('.lane');
      if (lane) pick(Number(lane.dataset.lane));
    });
    fig.addEventListener('keydown', (e) => {
      const lane = (e.target as Element).closest<SVGGElement>('.lane');
      if (lane && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        pick(Number(lane.dataset.lane));
      }
    });
    setLanes(4);
    // Show the grown tree at rest, so the drawing is complete before anyone presses anything.
    for (let i = 0; i < n(); i++) laneEls[i].classList.add('grown');
  }
</script>
