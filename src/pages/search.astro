---
import Base from '../layouts/Base.astro';
---
<Base title="Seek" description="Search every folio of the wiki." current="search">
  <main class="leaf" id="text">
    <div class="running-head"><span>Codex Tebou</span><span class="folio-no">Seek</span></div>
    <div class="folio">
      <div class="text-block" style="grid-column: 1 / -1; max-width: 46rem; margin-inline: auto; width: 100%">
        <p class="kicker">The seeker</p>
        <h1 class="title">Seek</h1>
        <p class="summary" style="margin-top: 1rem">Every folio is indexed word by word when the library is built. Type to search; results come from that index, in your browser.</p>
        <form class="seek-form seek-page" role="search" action="/search/" style="border: 1px solid var(--rule); border-radius: 999px; background: color-mix(in srgb, var(--paper) 70%, transparent)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6" /><path d="m15 15 5.5 5.5" /></svg>
          <label class="visually-hidden" for="seek-page-input">Seek in the library</label>
          <input id="seek-page-input" class="seek-input" type="search" name="q" placeholder="Seek a word, a tool, a folio…" autocomplete="off" spellcheck="false" aria-controls="seek-page-results" />
        </form>
        <ul id="seek-page-results" class="seek-results" style="max-height:none; margin-top: 1rem" aria-live="polite"></ul>
        <noscript><p>Searching needs JavaScript. The <a href="/pinakes/">Pinakes</a> lists every folio.</p></noscript>
      </div>
    </div>
  </main>
</Base>
