---
// The headpiece: a band of white vine across the head of the book's first page (lib/illumination.mjs draws it).
// Ornament only. A narrow screen shows as many curls as fit, at the same size.
import { headpiece } from '../../lib/illumination.mjs';

interface Props {
  seed?: number;
}
const { seed = 1 } = Astro.props;
const band = headpiece({ seed, count: 22 });
---
<div class="headpiece" aria-hidden="true">
  <svg viewBox={`0 0 ${band.width} 100`} preserveAspectRatio="xMidYMid slice" focusable="false" set:html={band.markup} />
</div>
