---
// Cole's opinions, set apart as a reader's note: a stroke of red chalk down the side and a manicule in the margin.
// Used in MDX as <ColesTake>...</ColesTake>.
import Manicule from './Manicule.astro';
---
{/* A note in the text, not a region of the page: a folio can hold several, and landmarks of one name would be
    indistinguishable. */}
<div class="coles-take" role="note" aria-label="Cole's take">
  <p class="label"><Manicule />Cole’s take</p>
  <div class="body"><slot /></div>
</div>
