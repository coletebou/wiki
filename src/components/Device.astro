---
// A table's device (src/data/devices.ts), in ink: the traced drawing is a mask the ink colour shows through, so it
// follows the theme. Ornament: the table's name stands beside it wherever it is used, so it is hidden from assistive
// technology.
import { DEVICES } from '../data/devices';

interface Props {
  /** The table's id. */
  table: string;
  /** At the head of a table in the catalogue: the pen's own line. Elsewhere it is small, cut with a broader nib. */
  large?: boolean;
}
const { table, large = false } = Astro.props;
const device = DEVICES[table];
---
{device && <span class="device" style={`--m: url("${large ? device.src : device.small}")`} aria-hidden="true"></span>}
