---
// Ornament only: lines from Leonardo's notebooks in his mirror-image hand, and small ink studies, in the outer
// margin. Hidden from assistive technology and never used for content.
interface Props {
  folio: number;
}
const { folio } = Astro.props;
const lines = [
  'Chi poco pensa, molto erra',
  'Ogni nostra cognizione prencipia da sentimenti',
  'La sapienza è figliola della sperienza',
  'Ostinato rigore',
  'Di mi se mai fu fatta alcuna cosa',
  'O tempo, consumatore delle cose',
  'Ogni impedimento è distrutto dal rigore',
  'Studia prima la scienza, e poi seguita la pratica',
  'Il ferro s’arrugginisce sanza esercizio',
  'L’acqua che tocchi de’ fiumi è l’ultima di quella che andò',
];
const pick = (i: number) => lines[(folio * 7 + i * 3) % lines.length];
const study = folio % 5;
---
<div class="marginalia" aria-hidden="true">
  <p style="--tilt: -5deg">{pick(0)}</p>
  {study === 0 && (
    <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round">
      <path d="M60 60c4-1 6 3 4 7-3 6-12 5-15-1-4-9 3-19 13-20 14-1 23 12 20 25-4 17-23 25-38 18C25 81 19 58 31 43 45 26 73 24 89 39c19 18 17 49-3 63" />
      <path d="M18 104c14 6 34 7 50 1M92 22c-10-6-24-8-36-5" opacity=".6" />
      <path d="M40 92l-3 7M50 95l-1 7M61 96l1 7M72 94l2 7" opacity=".5" />
    </svg>
  )}
  {study === 1 && (
    <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round">
      <circle cx="60" cy="60" r="30" /><circle cx="60" cy="60" r="8" /><circle cx="60" cy="60" r="22" opacity=".5" />
      {Array.from({ length: 16 }, (_, i) => {
        const a = (i / 16) * Math.PI * 2;
        const b = a + 0.12;
        return <path d={`M${60 + 30 * Math.cos(a)} ${60 + 30 * Math.sin(a)} L${60 + 37 * Math.cos(a + 0.03)} ${60 + 37 * Math.sin(a + 0.03)} L${60 + 37 * Math.cos(b)} ${60 + 37 * Math.sin(b)} L${60 + 30 * Math.cos(b + 0.03)} ${60 + 30 * Math.sin(b + 0.03)}`} />;
      })}
      <path d="M38 38l44 44M82 38 38 82" opacity=".35" />
    </svg>
  )}
  {study === 2 && (
    <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round">
      <path d="M10 70C30 40 70 28 112 30" /><path d="M10 70c22-8 52-14 98-12" />
      {Array.from({ length: 9 }, (_, i) => <path d={`M${18 + i * 10} ${62 - i * 3.2}c3 6 4 10 3 ${14 - i}`} opacity=".7" />)}
      <path d="M10 70l-4 10M10 70c6 10 18 16 30 18" opacity=".6" />
    </svg>
  )}
  {study === 3 && (
    <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round">
      <circle cx="60" cy="62" r="44" /><rect x="22" y="24" width="76" height="76" />
      <path d="M60 18v88M16 62h88M22 24l76 76M98 24 22 100" opacity=".4" />
      <path d="M60 30c-3 0-5 3-5 6s2 6 5 6 5-3 5-6-2-6-5-6Z" />
    </svg>
  )}
  {study === 4 && (
    <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round">
      <path d="M60 14v92" /><ellipse cx="60" cy="40" rx="40" ry="10" /><path d="M20 40c4 18 22 30 40 34 18-4 36-16 40-34" />
      <path d="M26 54c10 10 22 14 34 16 12-2 24-6 34-16" opacity=".55" /><path d="M48 106h24M54 96h12" />
    </svg>
  )}
  <p style="--tilt: 3deg">{pick(1)}</p>
  <p style="--tilt: -2deg">{pick(2)}</p>
</div>
