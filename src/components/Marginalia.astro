---
// Ornament only: lines from Leonardo's notebooks in his mirror-image hand, and one of his own sketches of a machine,
// traced from his notebooks (scripts/trace-leonardo.mjs), in the outer margin. Hidden from assistive technology and
// never used for content. Point at a line and it turns to face you, and a tag gives its English
// (src/scripts/sillybos.ts reads the data-gloss attributes).
import clavis from '../assets/leonardo/clavis.svg?url';
import cochlea from '../assets/leonardo/cochlea.svg?url';
import flumen from '../assets/leonardo/flumen.svg?url';
import geometria from '../assets/leonardo/geometria.svg?url';
import porta from '../assets/leonardo/porta.svg?url';
import rotae from '../assets/leonardo/rotae.svg?url';
import veru from '../assets/leonardo/veru.svg?url';
import volano from '../assets/leonardo/volano.svg?url';
import volatus from '../assets/leonardo/volatus.svg?url';
import { LINES } from '../data/leonardo';

interface Props {
  folio: number;
  /** The folio's table: each table keeps a sketch of its own kind. */
  table: string;
}
const { folio, table } = Astro.props;
const pick = (i: number) => LINES[(folio * 7 + i * 3) % LINES.length];
// Each table's sketch, nine of his machines for ten tables: the keyboard of his viola organista for the Desk and
// its keyboards, the aerial screw for the Shell (a shell's own spiral), the spit that turns itself for the Automata,
// wheels in mesh for the Workshop, the great press for the Works, the game of circles for the Observatory, the flying
// machine for the Atelier, the same circles struck as coins for the Mint, water running its course for the Ledger
// (money is spent as a river runs), and a door's lock for the Library.
const SKETCHES = {
  desk: clavis,
  shell: cochlea,
  automata: veru,
  workshop: rotae,
  works: volano,
  observatory: geometria,
  atelier: volatus,
  mint: geometria,
  ledger: flumen,
  library: porta,
} as Record<string, string>;
const sketch = SKETCHES[table] ?? [cochlea, geometria, rotae, veru, volano, volatus][folio % 6];
const source = (n?: number) => (n ? `Richter, § ${n}` : 'A plain rendering');
---
<div class="marginalia" aria-hidden="true">
  {[
    { line: pick(0), tilt: '-5deg' },
    null,
    { line: pick(1), tilt: '3deg' },
    { line: pick(2), tilt: '-2deg' },
  ].map((m) =>
    m ? (
      <p style={`--tilt: ${m.tilt}`} data-gloss={m.line.it} data-gloss-en={m.line.en} data-gloss-source={source(m.line.richter)}>{m.line.it}</p>
    ) : (
      <span class="margin-sketch" style={`--m: url("${sketch}")`}></span>
    ),
  )}
</div>
