// The crotch, where the inner contours of the legs meet.
const crotch = 'M203.6 240.4Q201.2 243.2 200 246.2Q198.8 243.2 196.4 240.4';

// ── The construction, the measures, the machine ─────────────────────────────────────────────────────────────
const SQ = { x: CX - S / 2, y: TOP, s: S };
