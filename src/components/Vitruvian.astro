  .join('');
const scaleTicks = Array.from({ length: 25 }, (_, i) => `M${r1(SQ.x + i * palm)} ${scaleY - (i % 6 === 0 ? 3.4 : 1.4)}v${i % 6 === 0 ? 7 : 5}`).join('') + Array.from({ length: 3 }, (_, i) => `M${r1(SQ.x + (i + 1) * (palm / 4))} ${scaleY + 3.6}v2.4`).join('');
const headTicks = Array.from({ length: 9 }, (_, i) => `M${SQ.x - (i % 4 === 0 ? 7 : 4.5)} ${TOP + i * (S / 8)}h${i % 4 === 0 ? 7 : 4.5}`).join('');
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
const circleTicks = Array.from({ length: 72 }, (_, i) => {
  const deg = i * 5;
  const long = deg % 45 === 0;
  const a = onCircle(deg, R);
  const b = onCircle(deg, R + (long ? 4.6 : 2.2));
  return `M${xy(a)}L${xy(b)}`;
}).join('');
// The arms' swing between the poses, struck from each shoulder just beyond the fingertips.
const arc = (c: P, from: P, to: P) => {
  const r = len(sub(from, c));
  const sweep = (from[0] - c[0]) * (to[1] - c[1]) - (from[1] - c[1]) * (to[0] - c[0]) > 0 ? 1 : 0;
  return `M${xy(from)}A${r1(r)} ${r1(r)} 0 0 ${sweep} ${xy(to)}`;
};
const flatTip = flatArm[flatArm.length - 1];
const reach = (c: P, tip: P, extra: number) => add(c, mul(unit(sub(tip, c)), len(sub(tip, c)) + extra));
const swingD = [1, -1]
  .map((side) => {
    const c = side === 1 ? SHOULDER : mx(SHOULDER);
    const f = side === 1 ? flatTip : mx(flatTip);
    const r = side === 1 ? raisedTip : mx(raisedTip);
    return arc(c, reach(c, f, 9), reach(c, r, 9));
  })
  .join('');

/** A toothed wheel, as Leonardo drew them: a rim of square teeth, a hub, spokes. */
function wheel(c: P, r: number, teeth: number, phase = 0, th = 3.4) {
  const pts: P[] = [];
  for (let i = 0; i < teeth; i++) {
    const a0 = phase + (i / teeth) * Math.PI * 2;
    const w = (Math.PI * 2) / teeth;
    for (const [f, rr] of [[0, r], [0.12, r + th], [0.45, r + th], [0.57, r]] as const) pts.push(add(c, [Math.cos(a0 + f * w) * rr, Math.sin(a0 + f * w) * rr]));
  }
  const spokes = Array.from({ length: 4 }, (_, i) => {
    const a = phase + (i * Math.PI) / 2 + 0.3;
    return `M${xy(add(c, [Math.cos(a) * 3.2, Math.sin(a) * 3.2]))}L${xy(add(c, [Math.cos(a) * (r - 3.4), Math.sin(a) * (r - 3.4)]))}`;
  }).join('');
  // The inner ring as two half circles: an arc that ends where it starts is not drawn at all.
  return { rim: poly(pts), inner: `M${xy(add(c, [r - 3, 0]))}A${r - 3} ${r - 3} 0 0 1 ${xy(add(c, [3 - r, 0]))}A${r - 3} ${r - 3} 0 0 1 ${xy(add(c, [r - 3, 0]))}`, spokes, hub: c };
}
// In mesh: the centres a pitch radius apart (each wheel's root plus half its teeth).
const bigWheel = wheel([33, 338], 17, 16, 0.1);
const smallWheel = wheel([33 + 30 * Math.cos((-76 * Math.PI) / 180), 338 + 30 * Math.sin((-76 * Math.PI) / 180)], 9.6, 9, 0.45);
// A coiled cord from the square's corner, as a spring is drawn, ending in a plug.
const coil = (() => {
  const start: P = [SQ.x + S + 0.5, 336];
  const end: P = [372, 382];
  const d0 = sub(end, start);
  const L = len(d0);
  const v = unit(d0);
  const n: P = [-v[1], v[0]];
  const turns = 9;
  const pts: P[] = [];
  for (let i = 0; i <= turns * 12; i++) {
    const t = i / (turns * 12);
    const ph = t * turns * Math.PI * 2;
    const env = Math.min(1, t * 8, (1 - t) * 8);
    const base = add(start, mul(v, t * L));
    pts.push(add(base, add(mul(n, Math.sin(ph) * 4.2 * env), mul(v, -Math.cos(ph) * 2.6 * env))));
  }
  return { d: `M${pts.map(xy).join('L')}`, end, v, n };
})();
const plug = (() => {
  const { end, v, n } = coil;
  const q = (a: number, b: number): P => add(end, add(mul(v, a), mul(n, b)));
  return {
    body: poly([q(0, -3.4), q(10, -4), q(10, 4), q(0, 3.4)]),
    pins: `M${xy(q(10, -2))}L${xy(q(15.5, -2))}M${xy(q(10, 2))}L${xy(q(15.5, 2))}M${xy(q(3, -3.6))}L${xy(q(3, 3.6))}`,
    shade: poly([q(0.6, 1), q(9.6, 1.2), q(9.6, 3.6), q(0.6, 3)]),
