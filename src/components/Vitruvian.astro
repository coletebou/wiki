/** Parallel strokes at an angle across a box, for a clip to cut into hatching. */
function strokes(box: [number, number, number, number], gap: number, deg: number, jitter = 0.3) {
  const a = (deg * Math.PI) / 180;
  const v: P = [Math.cos(a), Math.sin(a)];
  const u: P = [-v[1], v[0]];
  const [x0, y0, x1, y1] = box;
  const corners: P[] = [[x0, y0], [x1, y0], [x0, y1], [x1, y1]];
  const cs = corners.map((c) => dot(c, u));
  const ls = corners.map((c) => dot(c, v));
  const [cmin, cmax, lmin, lmax] = [Math.min(...cs), Math.max(...cs), Math.min(...ls), Math.max(...ls)];
  let d = '';
  let i = 0;
  for (let c = cmin; c <= cmax; c += gap, i++) {
    const cc = c + Math.sin(i * 1.7) * jitter;
    const p = add(mul(u, cc), mul(v, lmin));
    const q = add(mul(u, cc), mul(v, lmax));
    d += `M${xy(p)}L${xy(q)}`;
  }
  return d;
}
const FIG_BOX: [number, number, number, number] = [74, 112, 326, 368];
const hatch = strokes(FIG_BOX, 1.9, 58);
const crossHatch = strokes(FIG_BOX, 2.1, 128, 0.2);

const contours = {
