  armsL: armsL.map((l) => l.whole),
  legs: legs.map((l) => l.a + l.b),
  legsL: legsL.map((l) => l.a + l.b),
  weight: [...arms, ...armsL, ...legs, ...legsL].map((l) => l.weight).join(''),
