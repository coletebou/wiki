---
// The frontispiece: Leonardo's Vitruvian man, redrawn as the beast. One man in two poses inscribed in the circle
// and the square, on Vitruvius' own measures (the head an eighth of the height, the navel the circle's centre, the
// arms' span the height). The machine is drawn into him: a prompt at the navel, the square's four quarters numbered as
// tmux numbers its panes, and instruments in the margins. Everything is computed here, at build time, into plain
// strokes: the limbs from a skeleton and a width at each point along it, the hatching from the side of each form that
// faces away from the light, which falls from the upper left. The hatching runs from upper left to lower right, the
// way Leonardo's left hand drew it. Ornament only: hidden from assistive technology.
type P = [number, number];

const S = 240; // the square's side: the man's height
const CX = 200; // the axis
const TOP = 120; // the crown, on the square's top
const FOOT = TOP + S; // the soles, on the square's foot
const R = 146; // the circle: from the navel to the soles, 0.608 of the height
const NAVEL: P = [CX, FOOT - R];
const LIGHT: P = unit([1, 1.25]);

function add(a: P, b: P): P {
  return [a[0] + b[0], a[1] + b[1]];
}
function sub(a: P, b: P): P {
  return [a[0] - b[0], a[1] - b[1]];
}
function mul(a: P, k: number): P {
  return [a[0] * k, a[1] * k];
}
function len(a: P) {
  return Math.hypot(a[0], a[1]);
}
function unit(a: P): P {
  return mul(a, 1 / (len(a) || 1));
}
const dot = (a: P, b: P) => a[0] * b[0] + a[1] * b[1];
const mx = (p: P): P => [2 * CX - p[0], p[1]];
const r1 = (n: number) => Math.round(n * 10) / 10;
const xy = (p: P) => `${r1(p[0])} ${r1(p[1])}`;
const onCircle = (deg: number, r = R): P => [NAVEL[0] + r * Math.sin((deg * Math.PI) / 180), NAVEL[1] + r * Math.cos((deg * Math.PI) / 180)];

/** A smooth curve through the points (Catmull-Rom as cubic Béziers). */
function smooth(pts: P[], closed = false, k = 1 / 6): string {
  const n = pts.length;
  if (n < 2) return '';
  const at = (i: number) => (closed ? pts[(i + n) % n] : pts[Math.max(0, Math.min(n - 1, i))]);
  let d = `M${xy(pts[0])}`;
  for (let i = 0; i < (closed ? n : n - 1); i++) {
    const [p0, p1, p2, p3] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
    d += `C${xy([p1[0] + (p2[0] - p0[0]) * k, p1[1] + (p2[1] - p0[1]) * k])} ${xy([p2[0] - (p3[0] - p1[0]) * k, p2[1] - (p3[1] - p1[1]) * k])} ${xy(p2)}`;
  }
  return closed ? `${d}Z` : d;
}
const poly = (pts: P[]) => `M${pts.map(xy).join('L')}Z`;
/** A clip region needs no tenths: its outer edge already runs past the contour it hugs. */
const zone = (pts: P[]) => `M${pts.map((p) => `${Math.round(p[0])} ${Math.round(p[1])}`).join('L')}Z`;

/** A point and its direction at fraction t of the way along a polyline. */
function walker(spine: P[]) {
  const segs = spine.slice(1).map((p, i) => len(sub(p, spine[i])));
  const total = segs.reduce((a, b) => a + b, 0);
  const at = (t: number): P => {
    let d = Math.max(0, Math.min(1, t)) * total;
    for (let i = 0; i < segs.length; i++) {
      if (d <= segs[i] || i === segs.length - 1) return add(spine[i], mul(sub(spine[i + 1], spine[i]), Math.min(1, d / segs[i])));
      d -= segs[i];
    }
    return spine[spine.length - 1];
  };
  const dir = (t: number): P => unit(sub(at(Math.min(1, t + 0.035)), at(Math.max(0, t - 0.035))));
  return { at, dir, total };
}

/** A width that eases through keyframes [t, a, b] (Hermite through Catmull-Rom tangents). */
function easing(keys: number[][], col: number) {
  return (t: number) => {
    let i = 0;
    while (i < keys.length - 2 && t > keys[i + 1][0]) i++;
    const [k0, k1, k2, k3] = [keys[Math.max(0, i - 1)], keys[i], keys[i + 1], keys[Math.min(keys.length - 1, i + 2)]];
    const h = k2[0] - k1[0] || 1;
    const s = Math.max(0, Math.min(1, (t - k1[0]) / h));
    const m1 = ((k2[col] - k0[col]) / (k2[0] - k0[0] || 1)) * h;
    const m2 = ((k3[col] - k1[col]) / (k3[0] - k1[0] || 1)) * h;
    const s2 = s * s;
    const s3 = s2 * s;
    return (2 * s3 - 3 * s2 + 1) * k1[col] + (s3 - 2 * s2 + s) * m1 + (-2 * s3 + 3 * s2) * k2[col] + (s3 - s2) * m2;
  };
}

interface Limb {
  /** Contour on side a (to the left of travel on screen: up for a limb drawn rightward, right for one drawn down). */
  a: string;
  b: string;
  /** Both sides joined round the far end, for an arm and its hand. */
  whole: string;
  /** The heavier line on the side away from the light. */
  weight: string;
  shade: P[][];
  deep: P[][];
}
/** A limb from its bones and its widths: two contours, and the bands of shadow inside them. */
function limb(spine: P[], keys: number[][], o: { from?: number; to?: number; fromB?: number } = {}): Limb {
  const { at, dir, total } = walker(spine);
  const wa = easing(keys, 1);
  const wb = easing(keys, 2);
  const from = o.from ?? 0;
  const fromB = o.fromB ?? from;
  const to = o.to ?? 1;
  const side = (t: number, s: 1 | -1): P => {
    const d = dir(t);
    return add(at(t), mul([d[1], -d[0]], s * (s === 1 ? wa(t) : wb(t))));
  };
  const n = Math.max(10, Math.round(total / 4.5));
  const ts = (f: number) => Array.from({ length: n + 1 }, (_, i) => f + ((to - f) * i) / n);
  const A = ts(from).map((t) => side(t, 1));
  const B = ts(fromB).map((t) => side(t, -1));
  // The heavier line: the stretches of each contour that turn away from the light.
  const weights: string[] = [];
  for (const [pts, list, s] of [[A, ts(from), 1], [B, ts(fromB), -1]] as const) {
    let run: P[] = [];
    list.forEach((t, i) => {
      const d = dir(t);
      if (dot(mul([d[1], -d[0]], s), LIGHT) > 0.2 && i > 0 && i < list.length - 1) run.push(pts[i]);
      else {
        if (run.length > 2) weights.push(smooth(run));
        run = [];
      }
    });
    if (run.length > 2) weights.push(smooth(run));
  }
  const whole = smooth([...A, ...B.slice().reverse()]);
  // Shadow: on each side, a band whose depth follows how far that side turns from the light, ending in staggered
  // strokes like a hand's.
  const shade: P[][] = [];
  const deep: P[][] = [];
  for (const s of [1, -1] as const) {
    const m = Math.max(20, Math.round(total / 2));
    let run: { out: P; inn: P; dp: P }[] = [];
    const flush = () => {
      if (run.length > 3) {
        shade.push([...run.map((r) => r.out), ...run.map((r) => r.inn).reverse()]);
        const deepRun = run.filter((r) => len(sub(r.dp, r.out)) > 0.3);
        if (deepRun.length > 3) deep.push([...deepRun.map((r) => r.out), ...deepRun.map((r) => r.dp).reverse()]);
      }
      run = [];
    };
    for (let i = 0; i <= m; i++) {
      const t = (s === 1 ? from : fromB) + ((to - (s === 1 ? from : fromB)) * i) / m;
      const d = dir(t);
      const nrm = mul([d[1], -d[0]], s);
      const w = s === 1 ? wa(t) : wb(t);
      const facing = dot(nrm, LIGHT);
      const env = Math.pow(Math.sin(Math.PI * Math.min(1, Math.max(0, (t - from) / (to - from || 1)))), 0.45);
      if (facing > 0.12) {
        const depth = w * (0.34 + 0.56 * facing) * env * (i % 2 ? 0.86 : 1.06);
        const out = add(at(t), mul(nrm, w + 0.4));
        const inn = add(at(t), mul(nrm, w - depth));
        const dp = add(at(t), mul(nrm, w - (facing > 0.68 ? depth * 0.48 * (i % 3 ? 0.85 : 1.1) : 0)));
        run.push({ out, inn, dp });
      } else flush();
    }
    flush();
  }
  return { a: smooth(A), b: smooth(B), whole, weight: weights.join(''), shade, deep };
}

/** Mirror a path's coordinates across the axis (only for paths of absolute M, L, C and Z commands). */
function mirrorD(d: string): string {
  return d.replace(/(-?\d+(?:\.\d+)?) (-?\d+(?:\.\d+)?)/g, (_, x, y) => `${r1(2 * CX - Number(x))} ${y}`);
}

// ── The bones ─────────────────────────────────────────────────────────────────────────────────────────────────
// Right side of the page; the left is the mirror image. Heights after Vitruvius: chin at an eighth, the nipples at a
// quarter, the groin at the half, the knee a quarter up from the soles; an arm from shoulder to fingertip is a little
// under half the span.
const SHOULDER: P = [221, 167];
const flatArm: P[] = [SHOULDER, [272, 167.4], [297, 167], [CX + S / 2, 166.6]];
// The raised arm: the middle finger on the circle, level with the crown.
const raisedShoulder: P = [221, 163.5];
// "Raise your arms till your middle fingers touch the level of the top of your head": the fingertip is where the
// circle crosses the crown's height.
const raisedTip = onCircle(180 - (Math.acos((TOP - NAVEL[1]) / -R) * 180) / Math.PI);
const along = (p: P, q: P, t: number): P => add(p, mul(sub(q, p), t));
const raisedArm: P[] = [raisedShoulder, along(raisedShoulder, raisedTip, 0.5), along(raisedShoulder, raisedTip, 0.76), raisedTip];

const ARM_KEYS = [
  [0, 8, 9.8],
  [0.08, 9.7, 8.4],
  [0.16, 8.7, 7.6],
  [0.25, 6.6, 6.9],
  [0.35, 6.5, 7.1],
  [0.45, 5.1, 5.4],
  [0.51, 4.6, 4.6],
  [0.58, 6.1, 5.3],
  [0.7, 4.3, 3.9],
  [0.77, 3.1, 3.0],
  [0.84, 3.8, 3.5],
  [0.93, 3.4, 3.0],
  [0.985, 2.1, 1.8],
  [1, 0.7, 0.7],
];
const HIP: P = [211, 238];
const flatLeg: P[] = [HIP, [207.8, 298], [206.6, 350]];
// Outside, then inside: the hip, the long swell of the outer thigh, the inner thigh's teardrop just above the knee, the
// knee, the calf (its inner head higher and fuller), the narrowing to the ankle and its bones.
const LEG_KEYS = [
  [0, 13.6, 9],
  [0.08, 13.2, 9.8],
  [0.2, 12.6, 9.4],
  [0.33, 11.2, 8.4],
  [0.42, 9.4, 8.6],
  [0.48, 8.0, 8.4],
  [0.54, 6.9, 6.6],
  [0.6, 7.6, 7.6],
  [0.66, 8.1, 7.4],
  [0.74, 6.9, 6.0],
  [0.84, 4.9, 4.3],
  [0.94, 3.7, 3.5],
  [1, 4.4, 4.2],
];
// The spread leg: "the space between the legs will be an equilateral triangle", so each leg leans 30 degrees, and
// reaches until its ankle stands just inside the circle, the sole on it.
function spreadAnkle() {
  const dir = unit([Math.sin(Math.PI / 6), Math.cos(Math.PI / 6)]);
  let a = 80;
  let b = 140;
  for (let i = 0; i < 40; i++) {
    const m = (a + b) / 2;
    if (len(sub(add(HIP, mul(dir, m)), NAVEL)) < R - 9.5) a = m;
    else b = m;
  }
  const ankle = add(HIP, mul(dir, (a + b) / 2));
  return { ankle, deg: (Math.atan2(ankle[0] - NAVEL[0], ankle[1] - NAVEL[1]) * 180) / Math.PI };
}
const spread = spreadAnkle();
const spreadLeg: P[] = [HIP, add(along(HIP, spread.ankle, 0.53), [1.2, -0.6]), spread.ankle];

const arms = [limb(flatArm, ARM_KEYS), limb(raisedArm, ARM_KEYS)];
const legs = [limb(flatLeg, LEG_KEYS, { fromB: 0.03 }), limb(spreadLeg, LEG_KEYS, { fromB: 0.03 })];
// The left side, drawn from the mirrored bones so that its shadow falls on its own right.
const mirrorBones = (b: P[]) => b.map(mx);
const armsL = [limb(mirrorBones(flatArm), ARM_KEYS.map(([t, a, b]) => [t, b, a])), limb(mirrorBones(raisedArm), ARM_KEYS.map(([t, a, b]) => [t, b, a]))];
const legsL = [limb(mirrorBones(flatLeg), LEG_KEYS.map(([t, a, b]) => [t, b, a]), { from: 0.03 }), limb(mirrorBones(spreadLeg), LEG_KEYS.map(([t, a, b]) => [t, b, a]), { from: 0.03 })];

/** A foot in profile: ankle, toe direction, the sole's normal (pointing to the ground), its length. */
function foot(ank: P, toe: P, down: P, L: number) {
  const f = unit(toe);
  const v = unit(down);
  const q = (u: number, w: number): P => add(ank, add(mul(f, u * L), mul(v, w * L)));
  // The shin's front down over the instep to the toes; the toes round under to the ball, the arch lifts, the heel
  // rounds and climbs into the tendon.
  const top = smooth([q(0.11, -0.24), q(0.15, -0.1), q(0.3, -0.01), q(0.5, 0.075), q(0.68, 0.135), q(0.83, 0.175), q(0.93, 0.215)]);
  const sole = smooth([q(0.93, 0.215), q(0.935, 0.26), q(0.86, 0.29), q(0.66, 0.3), q(0.42, 0.268), q(0.16, 0.296), q(0.02, 0.305), q(-0.09, 0.28), q(-0.15, 0.19), q(-0.13, 0.03), q(-0.1, -0.22)]);
  const toes = `M${xy(q(0.76, 0.16))}Q${xy(q(0.8, 0.23))} ${xy(q(0.79, 0.29))}M${xy(q(0.85, 0.18))}Q${xy(q(0.88, 0.235))} ${xy(q(0.87, 0.282))}`;
  const ankleBone = `M${xy(q(-0.03, -0.02))}Q${xy(q(0.03, -0.06))} ${xy(q(0.06, 0.02))}`;
  const shade = [q(0.16, 0.3), q(0.42, 0.272), q(0.66, 0.304), q(0.86, 0.294), q(0.84, 0.25), q(0.64, 0.25), q(0.42, 0.226), q(0.18, 0.25)];
  return { d: top + sole, fine: toes + ankleBone, shade };
}
// Turned out and toward us, so a little foreshortened.
const flatFoot = foot(flatLeg[2], [1, 0.3], [0.12, 1], 24);
const spreadFootR = foot(spread.ankle, [Math.cos((spread.deg * Math.PI) / 180), -Math.sin((spread.deg * Math.PI) / 180)], [Math.sin((spread.deg * Math.PI) / 180), Math.cos((spread.deg * Math.PI) / 180)], 29);
const feetR = [flatFoot, spreadFootR];

// ── The trunk, the neck and the head (right half, mirrored) ──────────────────────────────────────────────────
const trunkSide: P[] = [[223, 175.5], [224.6, 184], [224, 194], [221.8, 204], [219.6, 212.5], [219.2, 220], [221.2, 228], [223, 235], [224, 242]];
const trapezius: P[] = [[205.6, 153.5], [210.5, 157.2], [216.5, 159.4], [221.5, 160]];
const neck: P[] = [[205.2, 146.5], [205.5, 150.5], [205.8, 154.5]];
const face: P[] = [[200, 120.6], [206.4, 122.2], [210.2, 127.4], [210.9, 134.2], [209.8, 140.4], [207, 145.9], [203, 149.3], [200, 150.1]];
const hairOut: P[] = [[200, 119.2], [208.4, 120.6], [213.8, 126], [215.6, 133.6], [215, 141.2], [213, 147.4], [210.2, 151.6]];
const right = {
  trunk: smooth(trunkSide),
  trap: smooth(trapezius),
  neck: smooth(neck),
  face: smooth(face),
  hair: smooth(hairOut),
};
// Locks of hair, falling from the crown and curling at the jaw.
const locks = [
  'M201 119.6C205 120.4 209 123 210.6 127.4',
  'M203.5 121C209 123 213.4 128 213.6 134.6C213.8 140 211.4 144 211.8 147.6C212 150.2 214.2 150.8 215 149',
  'M210.4 128.6C212.2 133.2 211.4 138.2 210.6 142C210 145.6 211 149.2 213 151.4',
  'M205 120.4C207.6 121.6 210 124.4 211.6 128.6',
  'M212.8 140.2C214.6 143.6 215.6 147 213.6 150.4C212.6 152 210.6 152.4 209.6 150.8',
];
const brow = 'M201.4 133.2C202.8 131.8 205.6 131 208.6 132.1M202.2 133.6C204.2 132.6 206.4 132.4 208 132.8';
const eye = 'M202.3 135.6C203.6 134.3 205.6 134.1 207.2 135.3M203.4 136.4C204.4 136.8 205.6 136.7 206.4 136.2M206.8 137.8C207.8 138.6 208.6 139.8 208.8 141.2';
const nose = 'M201.2 133.8C201.2 136.6 201.7 139.4 202.4 141.3C202.9 142.6 201.8 143.3 200.6 142.8M199 142.4C199.4 143 200 143.2 200.6 142.8';
const mouth = 'M200 145.4C201.4 145.1 202.6 145.3 203.6 145.9';
const midline = 'M197.3 145.7C198.4 145.2 199.2 145.3 200 145.4M198.6 147.4C199.5 147.8 200.5 147.8 201.4 147.4M199 149.2C199.8 149.6 200.4 149.6 201 149.2';
const pupil: P = [204.6, 135.3];
// Anatomy, in finer line: collarbones, the chest, the line of the belly, the ribs, the crests of the hips.
const anatomyR = [
  'M201.6 160.8C206 159.6 213 160.4 220 162',
  'M200.8 183.6C205 185.4 211.4 185.4 216.4 182.4C218.6 181 220 178.6 221 176.4',
  'M201.2 196.6C206.4 198.4 212 201.4 216.6 206.4',
  'M202.6 204.2C205.2 204.6 207.2 205.4 208.4 206.6M202.8 223C205 222.6 207 222.8 208.2 223.6',
  'M218 228.4C214.4 233.6 209.6 239 204.2 243.6',
  'M205.6 149.8C204.6 153.4 203.2 157.6 201.4 160.6',
  'M224.4 168.2C228 167.4 231.4 167.6 234.6 169.2',
];
const anatomyMid = 'M200 166V206';
const nipples: P[] = [[212.2, 180.6], [187.8, 180.6]];
// Knees and shins on every leg, at the knee's height along each.
const kneeMarks = [flatLeg, spreadLeg].flatMap((bones) => {
  const w = walker(bones);
  const k = w.at(0.54);
  const d = w.dir(0.54);
  const n: P = [d[1], -d[0]];
  const cap = (s: number) => `M${xy(add(k, add(mul(n, -3.6 * s), mul(d, -2.4))))}Q${xy(add(k, add(mul(n, 0), mul(d, 3.6))))} ${xy(add(k, add(mul(n, 3.4), mul(d, -2.2))))}`;
  const shin = `M${xy(add(w.at(0.6), mul(n, 1.6)))}Q${xy(add(w.at(0.75), mul(n, 2.6)))} ${xy(add(w.at(0.92), mul(n, 0.8)))}`;
  return [cap(1), shin];
});
const kneeD = kneeMarks.join('');
// Elbows and the fold of the wrist on every arm.
const elbowD = [flatArm, raisedArm]
  .map((bones) => {
    const w = walker(bones);
    const e = w.at(0.51);
    const d = w.dir(0.51);
    const n: P = [d[1], -d[0]];
    const wr = w.at(0.775);
    return `M${xy(add(e, add(mul(n, 2.6), mul(d, -1.4))))}Q${xy(add(e, mul(d, 1.2)))} ${xy(add(e, add(mul(n, -2), mul(d, -1))))}M${xy(add(wr, mul(n, 2.6)))}L${xy(add(wr, mul(n, -2.4)))}`;
  })
  .join('');
// Fingers: three partings from the knuckles to the tips, and a thumb.
const handD = (bones: P[], thumbSide: 1 | -1) => {
  const w = walker(bones);
  let d = '';
  for (const off of [-1.3, 0.1, 1.4]) {
    const a = w.at(0.86);
    const b = w.at(0.975);
    const dir = w.dir(0.93);
    const n: P = [dir[1], -dir[0]];
    d += `M${xy(add(a, mul(n, off)))}L${xy(add(b, mul(n, off * 0.7)))}`;
  }
  const dir = w.dir(0.8);
  const n: P = mul([dir[1], -dir[0]], thumbSide);
  const base = add(w.at(0.79), mul(n, 3.3));
  const tip = add(w.at(0.9), mul(n, 5.4));
  d += `M${xy(base)}Q${xy(add(base, add(mul(n, 3), mul(dir, 3))))} ${xy(tip)}Q${xy(add(tip, add(mul(n, -1.6), mul(dir, -0.4))))} ${xy(add(w.at(0.87), mul(n, 2.9)))}`;
  return d;
};
const handsR = handD(flatArm, 1) + handD(raisedArm, 1);

// The trunk's shadow: down its right side and under the chest, the chin and the hair, staggered like strokes.
function band(pts: P[], inward: P, depth: (i: number) => number): P[] {
  const out = pts.map((p) => add(p, mul(inward, -0.4)));
  const inn = pts.map((p, i) => add(p, mul(inward, depth(i) * (i % 2 ? 0.7 : 1.1))));
  return [...out, ...inn.reverse()];
}
const sampleCurve = (pts: P[], per: number): P[] => {
  const out: P[] = [];
  for (let i = 0; i < pts.length - 1; i++) for (let j = 0; j < per; j++) out.push(along(pts[i], pts[i + 1], j / per));
  out.push(pts[pts.length - 1]);
  return out;
};
const trunkShade = band(sampleCurve(trunkSide, 4), [-1, 0], (i) => 3 + 4.2 * Math.sin((Math.PI * i) / 32));
const chestShade = band(sampleCurve([[202, 184.6], [208, 186.2], [214, 184.6], [219, 180.6]], 3), [0, 1], (i) => 2.6 + 1.6 * Math.sin((Math.PI * i) / 9));
const chinShade: P[] = [[196, 150.4], [200, 151.2], [204.6, 149.6], [205.6, 152.4], [205.6, 156.6], [203, 154.8], [200, 153.4], [196.6, 152.6]];
const hairShadeR: P[] = [[210.6, 127.4], [213.8, 127], [215.4, 134], [214.8, 141.4], [212.8, 147.6], [210, 151.4], [208.6, 146.6], [210.4, 140.8], [211, 134]];
