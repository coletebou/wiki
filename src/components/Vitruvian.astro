    const m = along(hinge, tip, 0.82);
    return { outline: poly([a, add(m, mul(n, 1.4)), tip, add(m, mul(n, -1.4)), b]), center: `M${xy(along(hinge, tip, 0.12))}L${xy(along(hinge, tip, 0.8))}`, shade: poly([hinge, add(m, mul(n, s === 1 ? -1.3 : 1.3)), tip, m]) };
  };
  return { hinge, tipA, tipB, legs: [leg(tipA, 1), leg(tipB, -1)], scribe: `M${xy(add(tipA, [-1, 2]))}A70 70 0 0 0 ${xy(add(tipB, [2, 2.5]))}` };
