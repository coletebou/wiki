---
// The frontispiece: Leonardo's Vitruvian man himself, traced from the sheet in Venice (scripts/trace-vitruvian.mjs
// made src/assets/vitruvian-man.svg from a public-domain photograph of it): the man in his two poses, the circle and
// the square, Leonardo's own mirror writing above and his scale beneath. Nothing is drawn over him. In the margins
// round him stand four of his machines, traced the same way from his notebooks (scripts/trace-leonardo.mjs): a
// geometric game of circles in a hexagon, the flying machine a man stands in, the winch's wheels in mesh, and the
// spit that the smoke of a fire turns by itself. Ornament only: hidden from assistive technology.
import geometria from '../assets/leonardo/geometria.svg?url';
import rotae from '../assets/leonardo/rotae.svg?url';
import veru from '../assets/leonardo/veru.svg?url';
import volatus from '../assets/leonardo/volatus.svg?url';
import sheet from '../assets/vitruvian-man.svg?url';

type P = [number, number];

// The frame the instruments are drawn in: a square 240 on a side with the circle's centre at the navel, as Vitruvius
// has it. The sheet's own circle, measured on the traced file, places that frame over the drawing.
const S = 240;
const CX = 200;
const TOP = 120;
const FOOT = TOP + S;
const R = 146;
const NAVEL: P = [CX, FOOT - R];
const SHEET = { w: 1056, h: 1180, navel: [529.8, 608.7] as P, radius: 484.2 };
const K = SHEET.radius / R;

const r1 = (n: number) => Math.round(n * 10) / 10;
const frame = `translate(${r1(SHEET.navel[0] - NAVEL[0] * K)} ${r1(SHEET.navel[1] - NAVEL[1] * K)}) scale(${K.toFixed(3)})`;
// The four machines, each in a box in the frame's units (x, y, width, height), clear of Leonardo's handwriting and of
// the circle, with its name beneath. The traced drawings are masks the ink shows through, as the sheet is.
const MACHINES = [
  { name: 'geometria', url: geometria, box: [-26, 106, 64, 64] },
  { name: 'volatus', url: volatus, box: [356, 106, 76, 68] },
  { name: 'rotae', url: rotae, box: [-30, 284, 74, 69] },
  { name: 'veru', url: veru, box: [356, 292, 40, 94] },
] as const;
---
<script is:inline>
  // The drawing draws itself on the first visit of a session; after that it is simply there.
  try {
    if (sessionStorage.getItem('codex-drawn')) document.documentElement.dataset.drawn = '';
    else addEventListener('pagehide', () => sessionStorage.setItem('codex-drawn', '1'), { once: true });
  } catch {}
</script>
<div class="vitruvian" aria-hidden="true">
  <div class="vt-sheet" style={`--sheet: url("${sheet}")`}></div>
  <svg class="vt-over" viewBox={`0 0 ${SHEET.w} ${SHEET.h}`} focusable="false">
    <defs>
      {MACHINES.map(({ name, url, box: [x, y, w, h] }) => (
        <mask id={`vt-${name}`} maskUnits="userSpaceOnUse" x={x} y={y} width={w} height={h} style="mask-type: alpha">
          <image href={url} x={x} y={y} width={w} height={h} preserveAspectRatio="xMidYMid meet" />
        </mask>
      ))}
    </defs>
    <g transform={frame}>
      <g class="vt-margin" style="--d: 2.2s">
        {MACHINES.map(({ name, box: [x, y, w, h] }) => (
          <g class="instrument">
            <rect x={x} y={y} width={w} height={h} mask={`url(#vt-${name})`} />
            <text class="label" x={x + w / 2} y={y + h + 9} text-anchor="middle">{name}</text>
          </g>
        ))}
      </g>
    </g>
  </svg>
</div>

<style>
  .vitruvian {
    position: relative;
    width: min(40rem, 100%);
    margin: 1.5rem auto 1.4rem;
    color: var(--ink-2);
  }
  /* The sheet is ink and nothing else: the traced drawing is a mask, and the ink shows through it in whatever the
     theme's ink is, brown by day and pale by lamplight. */
  .vt-sheet {
    aspect-ratio: 1056 / 1180;
    background: currentColor;
    -webkit-mask: var(--sheet) center / 100% 100% no-repeat;
    mask: var(--sheet) center / 100% 100% no-repeat;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  @media (forced-colors: active) {
    .vt-sheet {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }
  .vt-over {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .vt-over text,
  .vt-over rect {
    fill: currentColor;
    stroke: none;
  }
  .vitruvian .label {
    font-family: var(--font-text);
    font-style: italic;
    font-size: 7.5px;
    opacity: 0.8;
  }

  @media (max-width: 63.99rem) {
    /* A narrow screen has no margin for the instruments to stand in: they need the drawing's width and half as
       much again, or the edge of the leaf cuts them. */
    .vt-margin {
      display: none;
    }
  }
  @media print {
    /* On paper the drawing is simply there, whole. */
    .vt-sheet,
    .vt-margin {
      animation: none !important;
      opacity: 1 !important;
    }
  }
  /* On the first visit of a session the sheet comes up out of the navel, the centre Leonardo struck the circle from,
     and then the instruments are set down round it. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-drawn])) .vt-sheet {
      animation: vt-unveil 2.4s cubic-bezier(0.3, 0.1, 0.2, 1) both;
    }
    :global(html:not([data-drawn])) .vt-margin {
      opacity: 0;
      animation: vt-fade 1.1s ease var(--d, 1.2s) forwards;
    }
    @keyframes vt-unveil {
      from {
        clip-path: circle(0% at 50.2% 51.6%);
      }
      to {
        clip-path: circle(80% at 50.2% 51.6%);
      }
    }
    @keyframes vt-fade {
      to {
        opacity: 1;
      }
    }
  }
</style>
