---
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/italianno/400.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
// The four faces every page shows at its head (the wordmark, the navigation, the title), fetched at once and not
// after the stylesheet that names them has been read.
import garamond from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import garamondItalic from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-italic.woff2?url';
import cinzel from '@fontsource/cinzel/files/cinzel-latin-400-normal.woff2?url';
import cinzelBold from '@fontsource/cinzel/files/cinzel-latin-700-normal.woff2?url';
import '../styles/tokens.css';
import 'virtual:materials.css';
import '../styles/material.css';
import '../styles/codex.css';
import '../styles/illumination.css';
import '../styles/diagrams.css';

interface Props {
  title: string;
  description: string;
  /** Which masthead link is the current page. */
  current?: 'home' | 'pinakes' | 'planisphere' | 'search' | 'about' | 'agents';
  ogType?: 'website' | 'article';
  /** The not-found page: served at every missing address, so it names no address of its own and is not indexed. */
  notFound?: boolean;
  /** A page that is a tool and not a text (the lot-drawing page): not indexed. */
  noindex?: boolean;
}
const { title, description, current, ogType = 'website', notFound = false, noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = notFound || noindex ? null : new URL(Astro.url.pathname, site).href;
const fullTitle = current === 'home' ? 'Codex Tebou · How to Be a Beast' : `${title} · Codex Tebou`;

// The other editions of coletebou.com. ?from=wiki tells each one where the reader came from.
const editions = [
  { key: 'almanac', name: 'Almanac', href: 'https://coletebou.com/' },
  { key: 'civil', name: 'Plan Set', href: 'https://plans.coletebou.com/' },
  { key: 'terminal', name: 'Terminal', href: 'https://term.coletebou.com/' },
  { key: 'wiki', name: 'Wiki', href: null },
];
const withFrom = (h: string) => {
  const u = new URL(h);
  u.searchParams.set('from', 'wiki');
  return u.href;
};
---
<!doctype html>
<html lang="en" data-theme="vellum">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    {[garamond, garamondItalic, cinzel, cinzelBold].map((font) => <link rel="preload" as="font" type="font/woff2" href={font} crossorigin />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/atom+xml" title="Codex Tebou: emendations" href="/emendations.xml" />
    <meta name="theme-color" content="#d3cbbb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0a07" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="Codex Tebou" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/og.jpg', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Codex Tebou, How to Be a Beast: the title in gold on vellum, beside Leonardo's Vitruvian Man" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Before first paint: the reader's chosen theme, else the system's.
      (() => {
        let t = 'vellum';
        try {
          t = localStorage.getItem('codex-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'lucerna' : 'vellum');
        } catch {}
        document.documentElement.dataset.theme = t;
      })();
      // Turning a leaf cross-fades. A turn cut short is simply not faded: the reader turned again before the leaf
      // had come up, or came to the lot-drawing page, which sends its reader on before it is ever shown. The
      // browser reports a fade cut short as an error on the page, which it is not; such reports, and only those,
      // are taken here.
      addEventListener('pageswap', (e) => {
        const to = e.activation && e.activation.entry && e.activation.entry.url ? new URL(e.activation.entry.url).pathname : '';
        if (e.viewTransition && (to === '/sortes/' || location.pathname === '/sortes/')) e.viewTransition.skipTransition();
      });
      addEventListener('unhandledrejection', (e) => {
        const why = e.reason;
        if (why && /^(AbortError|InvalidStateError|TimeoutError)$/.test(why.name) && /transition/i.test(why.message || '')) e.preventDefault();
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#text">Skip to the text</a>
    <header class="masthead">
      <a class="wordmark" href="/">
        <b>CODEX TEBOU</b> <i>How to Be a Beast</i><span class="visually-hidden">, the frontispiece</span>
      </a>
      <nav aria-label="Library">
        <a href="/pinakes/" aria-current={current === 'pinakes' ? 'page' : undefined}>Pinakes</a>
        <a href="/planisphere/" class="wide-only" aria-current={current === 'planisphere' ? 'page' : undefined}>Planisphere</a>
        <a href="/how-to-be-a-beast/" class="wide-only">Start here</a>
        <a href="/wiki-mcp/" class="wide-only" aria-current={current === 'agents' ? 'page' : undefined}>For agents</a>
        <a href="/about-this-wiki/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
        <button type="button" class="seek-button" data-seek aria-haspopup="dialog">Seek <kbd>/</kbd></button>
        <button type="button" class="lamp" data-theme-toggle aria-label="Light the lamp: switch to lamplight">
          <svg viewBox="0 0 34 26" aria-hidden="true">
            <circle class="lamp-glow" cx="27.4" cy="7.4" r="6.5" filter="url(#lamp-blur)" />
            <path class="lamp-flame" d="M27.6 11.2c2-1.7 2.2-4.1 0.1-7.9c-0.3 2.5-2.5 3.3-2.3 5.6c0.1 1.2 0.9 2.1 2.2 2.3Z" />
            <g fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.3 15.6c0-2.9 3.6-4.8 8.4-4.8c3.4 0 6 0.8 8 2.1l3.9-0.9c1-0.2 1.5 0.8 0.8 1.5l-3 3c-1.5 2.9-5.2 4.5-9.7 4.5c-4.8 0-8.4-2-8.4-5.4Z" />
              <path d="M11 13.3c1.3-1 5.2-1 6.5 0" />
              <path d="M6.5 14.2c-2.7-0.8-4 0.5-3.6 2c0.4 1.3 2.1 1.7 3.5 0.9" />
              <path d="M10.6 23.3h8.2" />
            </g>
            <defs><filter id="lamp-blur" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="2.6" /></filter></defs>
          </svg>
        </button>
      </nav>
    </header>

    <slot />

    <footer class="colophon">
      <div>
        <p>
          <b>Codex Tebou</b>, Cole Tebou’s commonplace book of tools, agents and infrastructure, catalogued after the manner of
          Callimachus. Text <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener">CC BY 4.0</a>,
          code <a href="https://github.com/coletebou/wiki/blob/master/LICENSE" rel="noopener">MIT</a>, fonts SIL Open Font License.
          Agents keep it through an <a href="/wiki-mcp/">MCP</a>; every emendation is a <a href="https://github.com/coletebou/wiki" rel="noopener">pull request</a>.
          <button type="button" class="keys-button" data-keys aria-haspopup="dialog">The keys <kbd>?</kbd></button>
        </p>
      </div>
      <ul class="editions" aria-label="Editions of coletebou.com">
        <li class="label">Editions</li>
        {editions.map((e) => (
          <li>{e.href ? <a href={withFrom(e.href)} data-edition={e.key}>{e.name}</a> : <span aria-current="page">{e.name}</span>}</li>
        ))}
      </ul>
    </footer>

    <dialog class="seek-dialog" aria-label="Seek in the library">
      <form class="seek-form" method="dialog" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6" /><path d="m15 15 5.5 5.5" /></svg>
        <label class="visually-hidden" for="seek-input">Seek in the library</label>
        <input id="seek-input" class="seek-input" type="search" placeholder="Seek a word, a tool, a folio…" autocomplete="off" spellcheck="false" aria-controls="seek-results" aria-autocomplete="list" />
        <button type="submit" class="visually-hidden">Close</button>
      </form>
      <ul id="seek-results" class="seek-results" role="listbox" aria-label="Results"></ul>
      <p class="seek-hint"><span><kbd>↑</kbd> <kbd>↓</kbd> to choose</span><span><kbd>Enter</kbd> to open</span><span><kbd>Esc</kbd> to close</span></p>
    </dialog>

    <dialog class="keys-dialog" aria-labelledby="keys-title">
      <form method="dialog">
        <h2 id="keys-title">The keys</h2>
        <dl class="keys-list">
          <div><dt><kbd>/</kbd></dt><dd>Seek in the library</dd></div>
          <div><dt><kbd>n</kbd> <kbd>p</kbd></dt><dd>The next leaf, the leaf before</dd></div>
          <div><dt><kbd>v</kbd></dt><dd>The back of this leaf: who cites it, its sources</dd></div>
          <div><dt><kbd>c</kbd></dt><dd>The catalogue</dd></div>
          <div><dt><kbd>m</kbd></dt><dd>The planisphere: the library as a map of stars</dd></div>
          <div><dt><kbd>h</kbd></dt><dd>The frontispiece</dd></div>
          <div><dt><kbd>s</kbd></dt><dd>Sortes: a leaf drawn by lot</dd></div>
          <div><dt><kbd>l</kbd></dt><dd>Light the lamp, or put it out</dd></div>
          <div><dt><kbd>?</kbd></dt><dd>These keys</dd></div>
        </dl>
        <p class="keys-note">A study that reads the keyboard itself, like the tmux keymap, keeps its keys while you are in it.</p>
        <button type="submit" class="keys-close">Close <kbd>Esc</kbd></button>
      </form>
    </dialog>

    <div class="sillybos" role="tooltip" id="sillybos" hidden></div>
    <div class="lumen" aria-hidden="true"></div>

    <script>
      import '../scripts/theme';
      import '../scripts/seek';
      import '../scripts/sillybos';
      import '../scripts/folio';
      import '../scripts/lately';
      import '../scripts/ribbon';
      import '../scripts/keys';
    </script>
  </body>
</html>
